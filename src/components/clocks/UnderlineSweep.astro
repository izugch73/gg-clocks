---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="uls"
  data-clock="underline-sweep"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="box">
    <div class="row">
      <span class="hm">--:--</span>
      <span class="sec" hidden={!opts.seconds}>--</span>
    </div>
    <div class="line" aria-hidden="true"><span class="glow"></span></div>
    <div class="meta">
      <span class="date" hidden={!opts.date}>--/-- ---</span>
      <span class="live" hidden={!opts.live}>LIVE</span>
    </div>
  </div>
</div>

<style>
  .uls {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    color: var(--fg);
  }
  .box {
    display: inline-flex;
    flex-direction: column;
    padding: 8px 12px;
    background: var(--bg);
  }
  .row {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    line-height: 1;
  }
  .hm {
    font-size: 48px;
    font-weight: 800;
    letter-spacing: -1.5px;
    font-variant-numeric: tabular-nums;
  }
  .sec {
    font-size: 15px;
    font-weight: 700;
    color: var(--accent);
    margin-top: 4px; /* superscript position beside the digits */
    font-variant-numeric: tabular-nums;
  }
  .line {
    position: relative;
    height: 3px;
    margin-top: 8px;
    overflow: hidden;
    background: color-mix(in srgb, var(--fg) 25%, transparent);
    border-radius: 2px;
  }
  .glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 30%;
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
    animation: uls-sweep 4s linear infinite;
  }
  .meta {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 8px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.5px;
  }
  .meta:not(:has(:not([hidden]))) {
    display: none;
  }
  .date {
    opacity: 0.6;
  }
  .live {
    color: var(--accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
  }
  @keyframes uls-sweep {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(333.4%);
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".uls")) mountDigital(el);
</script>
