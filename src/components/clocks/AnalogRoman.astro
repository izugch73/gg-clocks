---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;

const ROMAN = ["XII", "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI"];
---

<div
  class="ar"
  data-seconds={opts.seconds ? "1" : "0"}
  data-tz={opts.tz}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <svg viewBox="0 0 220 220" width="220" height="220" aria-hidden="true">
    <circle cx="110" cy="110" r="106" class="bezel-outer"></circle>
    <circle cx="110" cy="110" r="100" class="face"></circle>
    <circle cx="110" cy="110" r="100" class="face-stroke" fill="none"></circle>

    {Array.from({ length: 60 }).map((_, i) => (
      <line
        x1="110"
        y1="14"
        x2="110"
        y2={i % 5 === 0 ? 22 : 18}
        class={i % 5 === 0 ? "tick tick-major" : "tick"}
        transform={`rotate(${i * 6} 110 110)`}
      />
    ))}

    {ROMAN.map((label, i) => {
      const angle = (i / 12) * Math.PI * 2 - Math.PI / 2;
      const r = 80;
      const x = 110 + Math.cos(angle) * r;
      const y = 110 + Math.sin(angle) * r;
      return (
        <text x={x} y={y} class="num" text-anchor="middle" dominant-baseline="central">{label}</text>
      );
    })}

    <g class="hand-h">
      <line x1="110" y1="118" x2="110" y2="62" class="hand hand-hour" />
    </g>
    <g class="hand-m">
      <line x1="110" y1="122" x2="110" y2="42" class="hand hand-min" />
    </g>
    {opts.seconds && (
      <g class="hand-s">
        <line x1="110" y1="130" x2="110" y2="32" class="hand hand-sec" />
      </g>
    )}
    <circle cx="110" cy="110" r="4" class="pin"></circle>
    <circle cx="110" cy="110" r="2" class="pin-center"></circle>
  </svg>
</div>

<style>
  .ar {
    transform: scale(var(--scale, 1));
    transform-origin: center;
  }
  .ar svg {
    display: block;
  }
  .bezel-outer {
    fill: var(--fg);
  }
  .face {
    fill: var(--bg);
  }
  .face-stroke {
    stroke: color-mix(in srgb, var(--fg) 25%, transparent);
    stroke-width: 1;
  }
  .tick {
    stroke: var(--fg);
    stroke-width: 1;
    opacity: 0.7;
  }
  .tick-major {
    stroke-width: 2;
    opacity: 1;
  }
  .num {
    font-family: "Plus Jakarta Sans", "Cinzel", serif;
    font-weight: 700;
    font-size: 14px;
    fill: var(--fg);
    letter-spacing: 0.5px;
  }
  .hand {
    stroke: var(--fg);
    stroke-linecap: round;
  }
  .hand-hour {
    stroke-width: 4;
  }
  .hand-min {
    stroke-width: 2.5;
  }
  .hand-sec {
    stroke: var(--accent);
    stroke-width: 1.2;
  }
  .pin {
    fill: var(--fg);
  }
  .pin-center {
    fill: var(--accent);
  }
  .hand-h,
  .hand-m,
  .hand-s {
    transform-origin: 110px 110px;
    transition: transform 0.2s cubic-bezier(0.4, 2.2, 0.6, 1);
  }
  .hand-s {
    transition: transform 0.15s cubic-bezier(0.4, 2.2, 0.6, 1);
  }
</style>

<script>
  function init(el: HTMLElement) {
    const tz = el.dataset.tz || "Asia/Tokyo";
    const showSec = el.dataset.seconds === "1";
    const h = el.querySelector<SVGGElement>(".hand-h");
    const m = el.querySelector<SVGGElement>(".hand-m");
    const s = el.querySelector<SVGGElement>(".hand-s");
    if (!h || !m) return;
    function readParts() {
      const f = new Intl.DateTimeFormat("en-US", {
        timeZone: tz,
        hour12: false,
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
      });
      const parts = Object.fromEntries(f.formatToParts(new Date()).map((p) => [p.type, p.value]));
      return { h: Number(parts.hour), m: Number(parts.minute), s: Number(parts.second) };
    }
    function tick() {
      const { h: H, m: M, s: S } = readParts();
      const hourDeg = (H % 12) * 30 + M * 0.5;
      const minDeg = M * 6 + S * 0.1;
      const secDeg = S * 6;
      if (h) h.style.transform = `rotate(${hourDeg}deg)`;
      if (m) m.style.transform = `rotate(${minDeg}deg)`;
      if (s && showSec) s.style.transform = `rotate(${secDeg}deg)`;
    }
    tick();
    setInterval(tick, showSec ? 1000 : 15000);
  }
  for (const el of document.querySelectorAll<HTMLElement>(".ar")) init(el);
</script>
