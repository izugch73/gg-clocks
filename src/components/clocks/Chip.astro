---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="ch"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="pill">
    <span class="live" hidden={!opts.live}>
      <span class="dot" aria-hidden="true"></span>LIVE
    </span>
    <span class="time">
      <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
    </span>
    <span class="bullet" hidden={!opts.date} aria-hidden="true">·</span>
    <span class="date" hidden={!opts.date}>--/-- ---</span>
  </div>
</div>

<style>
  .ch {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    background: var(--bg);
    color: var(--fg);
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 4px 16px rgba(0, 0, 0, 0.06);
    font-weight: 600;
    line-height: 1;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
    font-size: 10px;
    letter-spacing: 1.5px;
    font-weight: 800;
  }
  .live .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .time {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.5px;
    font-variant-numeric: tabular-nums;
  }
  .time .sec {
    font-size: 13px;
    margin-left: 4px;
    opacity: 0.6;
    font-weight: 600;
  }
  .bullet {
    color: color-mix(in srgb, var(--fg) 35%, transparent);
    font-size: 16px;
    line-height: 1;
  }
  .date {
    font-size: 13px;
    color: color-mix(in srgb, var(--fg) 70%, transparent);
    font-weight: 600;
    letter-spacing: 0.5px;
  }
</style>

<script>
  type Lang = "ja" | "en";
  function partsFor(tz: string) {
    const f = new Intl.DateTimeFormat("en-US", {
      timeZone: tz,
      hour12: false,
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      weekday: "short",
    });
    return Object.fromEntries(f.formatToParts(new Date()).map((p) => [p.type, p.value])) as Record<string, string>;
  }
  function wd(en: string | undefined, lang: Lang): string {
    if (!en) return "";
    if (lang === "en") return en.toUpperCase();
    return { Sun: "日", Mon: "月", Tue: "火", Wed: "水", Thu: "木", Fri: "金", Sat: "土" }[en] ?? "";
  }
  function init(el: HTMLElement) {
    const tz = el.dataset.tz || "Asia/Tokyo";
    const lang = (el.dataset.lang as Lang) || "ja";
    const format = el.dataset.format || "24";
    const hmEl = el.querySelector<HTMLElement>(".hm");
    const secEl = el.querySelector<HTMLElement>(".sec");
    const dateEl = el.querySelector<HTMLElement>(".date");
    if (!hmEl) return;
    function tick() {
      const p = partsFor(tz);
      let hour = p.hour;
      let suffix = "";
      if (format === "12") {
        const h = Number(hour);
        hour = String(((h + 11) % 12) + 1).padStart(2, "0");
        suffix = h >= 12 ? " PM" : " AM";
      }
      if (hmEl) hmEl.textContent = `${hour}:${p.minute}${suffix}`;
      if (secEl) secEl.textContent = p.second ?? "";
      if (dateEl) dateEl.textContent = `${p.month}/${p.day} ${wd(p.weekday, lang)}`;
    }
    tick();
    setInterval(tick, 1000);
  }
  for (const el of document.querySelectorAll<HTMLElement>(".ch")) init(el);
</script>
