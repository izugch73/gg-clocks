---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="ng"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="frame">
    <div class="live" hidden={!opts.live}>● LIVE</div>
    <div class="time"><span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span></div>
    <div class="date" hidden={!opts.date}>--/-- ---</div>
  </div>
</div>

<style>
  .ng {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    padding: 12px 8px;
  }
  .frame {
    position: relative;
    background: var(--bg, transparent);
    border-radius: 14px;
    padding: 14px 26px 16px;
    text-align: center;
    color: var(--fg);
    font-family: "Audiowide", "Orbitron", system-ui, sans-serif;
    /* outer neon ring, only visible if bg is set */
    box-shadow:
      inset 0 0 0 1.5px color-mix(in srgb, var(--accent) 65%, transparent),
      0 0 22px color-mix(in srgb, var(--accent) 40%, transparent),
      0 0 60px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .live {
    display: inline-block;
    margin-bottom: 4px;
    padding: 2px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    color: var(--accent);
    font-size: 10px;
    letter-spacing: 3px;
    text-shadow:
      0 0 6px var(--accent),
      0 0 14px color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .time {
    font-size: 54px;
    line-height: 1;
    letter-spacing: 4px;
    font-variant-numeric: tabular-nums;
    text-shadow:
      0 0 6px var(--fg),
      0 0 14px color-mix(in srgb, var(--fg) 75%, transparent),
      0 0 28px color-mix(in srgb, var(--accent) 60%, transparent),
      0 0 56px color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .sec {
    font-size: 26px;
    margin-left: 6px;
    color: var(--accent);
    text-shadow:
      0 0 6px var(--accent),
      0 0 18px color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .date {
    margin-top: 8px;
    font-size: 14px;
    letter-spacing: 6px;
    color: var(--accent);
    text-shadow:
      0 0 6px var(--accent),
      0 0 16px color-mix(in srgb, var(--accent) 50%, transparent);
  }
</style>

<script>
  type Lang = "ja" | "en";

  function partsFor(tz: string) {
    const f = new Intl.DateTimeFormat("en-US", {
      timeZone: tz,
      hour12: false,
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      weekday: "short",
    });
    return Object.fromEntries(f.formatToParts(new Date()).map((p) => [p.type, p.value])) as Record<
      string,
      string
    >;
  }

  function wd(en: string | undefined, lang: Lang): string {
    if (!en) return "";
    if (lang === "en") return en.toUpperCase();
    return { Sun: "日", Mon: "月", Tue: "火", Wed: "水", Thu: "木", Fri: "金", Sat: "土" }[en] ?? "";
  }

  function init(el: HTMLElement) {
    const tz = el.dataset.tz || "Asia/Tokyo";
    const lang = (el.dataset.lang as Lang) || "ja";
    const format = el.dataset.format || "24";
    const hmEl = el.querySelector<HTMLElement>(".hm");
    const secEl = el.querySelector<HTMLElement>(".sec");
    const dateEl = el.querySelector<HTMLElement>(".date");
    if (!hmEl) return;

    function tick() {
      const p = partsFor(tz);
      let hour = p.hour;
      let suffix = "";
      if (format === "12") {
        const h = Number(hour);
        const h12 = ((h + 11) % 12) + 1;
        hour = String(h12).padStart(2, "0");
        suffix = h >= 12 ? " PM" : " AM";
      }
      if (hmEl) hmEl.textContent = `${hour}:${p.minute}${suffix}`;
      if (secEl) secEl.textContent = p.second ?? "";
      if (dateEl) dateEl.textContent = `${p.month}/${p.day} ${wd(p.weekday, lang)}`;
    }
    tick();
    setInterval(tick, 1000);
  }

  for (const el of document.querySelectorAll<HTMLElement>(".ng")) init(el);
</script>
