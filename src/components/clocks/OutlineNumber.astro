---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="on"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="wrap">
    <div class="time">
      <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
    </div>
    <div class="meta">
      <span class="live" hidden={!opts.live}>● LIVE</span>
      <span class="date" hidden={!opts.date}>--/-- ---</span>
    </div>
  </div>
</div>

<style>
  .on {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    padding: 6px 12px;
    font-family: "Plus Jakarta Sans", "Roboto", system-ui, sans-serif;
    background: var(--bg);
  }
  .time {
    font-size: 78px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 4px;
    color: transparent;
    -webkit-text-stroke: 2px var(--fg);
    text-stroke: 2px var(--fg);
    font-variant-numeric: tabular-nums;
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }
  .sec {
    font-size: 36px;
    -webkit-text-stroke: 1.5px var(--accent);
    text-stroke: 1.5px var(--accent);
    margin-left: 4px;
  }
  .meta {
    display: flex;
    gap: 12px;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 4px;
    padding-top: 6px;
    border-top: 1.5px solid var(--fg);
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--fg);
    font-weight: 700;
  }
  .live {
    color: var(--accent);
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".on")) mountDigital(el);
</script>
