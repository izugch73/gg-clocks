---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="ms"
  data-clock="mono-stack"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="stack">
    <div class="live" hidden={!opts.live}>● LIVE</div>
    <div class="time">
      <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
    </div>
    <div class="rule" data-with="date" hidden={!opts.date} aria-hidden="true"></div>
    <div class="date" hidden={!opts.date}>--/-- ---</div>
  </div>
</div>

<style>
  .ms {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Share Tech Mono", "Menlo", monospace;
    color: var(--fg);
    padding: 8px 16px;
    background: var(--bg);
    text-align: center;
  }
  .live {
    font-size: 10px;
    letter-spacing: 4px;
    color: var(--accent);
    margin-bottom: 4px;
    font-weight: 700;
  }
  .time {
    font-size: 36px;
    line-height: 1;
    font-weight: 400;
    letter-spacing: 2px;
    font-variant-numeric: tabular-nums;
  }
  .time .sec {
    font-size: 20px;
    margin-left: 4px;
    opacity: 0.65;
  }
  .rule {
    width: 30px;
    height: 1px;
    background: var(--accent);
    margin: 8px auto;
    opacity: 0.85;
  }
  .date {
    font-size: 12px;
    letter-spacing: 4px;
    text-transform: uppercase;
    opacity: 0.75;
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".ms")) mountDigital(el);
</script>
