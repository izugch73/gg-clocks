---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="lt"
  data-clock="luggage-tag"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <svg class="string" viewBox="0 0 60 130" width="60" height="130" aria-hidden="true">
    <path d="M52 65 C30 60, 8 56, 10 34 C12 14, 40 10, 44 30 C47 46, 30 52, 52 65" />
  </svg>
  <div class="tag">
    <div class="paper">
      <div class="top">
        <span class="label">BAGGAGE TAG</span>
        <span class="live" hidden={!opts.live}>● LIVE</span>
      </div>
      <div class="stripe">
        <span class="mini">FROM</span>
        <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
        <span class="mini">TO</span>
      </div>
      <div class="drow" data-with="date" hidden={!opts.date}>
        <span class="mini dl">DATE</span>
        <span class="date">--/-- ---</span>
      </div>
    </div>
    <span class="eyelet" aria-hidden="true"></span>
  </div>
</div>

<style>
  .lt {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    position: relative;
    width: 260px;
    height: 130px;
    font-family: "Bebas Neue", "Oswald", sans-serif;
  }
  .string {
    position: absolute;
    left: 0;
    top: 0;
  }
  .string path {
    fill: none;
    stroke: var(--fg);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .tag {
    position: absolute;
    left: 44px;
    top: 50%;
    transform: translateY(-50%);
    width: 214px;
    /* pivot at the eyelet (16px from the tag's left edge, vertical centre) */
    transform-origin: 16px 50%;
    animation: lt-swing 5s ease-in-out infinite;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.25));
  }
  .paper {
    padding: 8px 12px 10px 36px;
    color: var(--fg);
    background: linear-gradient(135deg, color-mix(in srgb, var(--bg) 85%, #fff), var(--bg) 55%, color-mix(in srgb, var(--bg) 85%, #000));
    clip-path: polygon(0 24%, 14% 0, 100% 0, 100% 100%, 14% 100%, 0 76%);
    -webkit-mask-image: radial-gradient(circle at 16px 50%, transparent 5px, #000 5.5px);
    mask-image: radial-gradient(circle at 16px 50%, transparent 5px, #000 5.5px);
  }
  .eyelet {
    position: absolute;
    left: 9px;
    top: 50%;
    width: 14px;
    height: 14px;
    margin-top: -7px;
    border-radius: 50%;
    border: 3px solid #c9c9c9;
    background: transparent;
    box-shadow:
      inset 0 0 0 1px #8a8a8a,
      0 0 0 1px #8a8a8a;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    letter-spacing: 2px;
    opacity: 0.8;
    margin-bottom: 6px;
  }
  .live {
    color: var(--accent);
    opacity: 1;
  }
  .stripe {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 -12px 0 -36px;
    padding: 4px 12px 4px 36px;
    background: var(--accent);
    color: #fff;
  }
  .mini {
    font-size: 10px;
    letter-spacing: 2px;
    opacity: 0.8;
  }
  .hm {
    flex: 1;
    text-align: center;
    font-size: 38px;
    line-height: 1;
    letter-spacing: 2px;
    font-variant-numeric: tabular-nums;
  }
  [data-format="12"] .hm {
    font-size: 30px;
    letter-spacing: 1px;
  }
  .sec {
    font-size: 18px;
    letter-spacing: 1px;
    opacity: 0.85;
  }
  .drow {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 8px;
    font-size: 16px;
    letter-spacing: 1.5px;
  }
  .dl {
    color: color-mix(in srgb, var(--fg) 70%, transparent);
  }
  .date {
    flex: 1;
    border-bottom: 2px dotted color-mix(in srgb, var(--fg) 55%, transparent);
    line-height: 1.1;
  }
  @keyframes lt-swing {
    0%,
    100% {
      transform: translateY(-50%) rotate(-1.6deg);
    }
    50% {
      transform: translateY(-50%) rotate(1.6deg);
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".lt")) mountDigital(el);
</script>
