---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="pf"
  data-clock="polaroid-frame"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="frame">
    <div class="tape" aria-hidden="true"></div>
    <div class="photo">
      <div class="sun" aria-hidden="true"></div>
      <div class="live" hidden={!opts.live}><span class="dot" aria-hidden="true"></span>REC</div>
      <div class="time"><span class="hm">--:--</span></div>
      <div class="sec" hidden={!opts.seconds}>--</div>
    </div>
    <div class="caption"><span class="date" hidden={!opts.date}>--/-- ---</span></div>
  </div>
</div>

<style>
  .pf {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    padding: 8px 12px;
    font-family: "Bebas Neue", "Oswald", sans-serif;
  }
  .frame {
    position: relative;
    width: 170px;
    box-sizing: border-box;
    padding: 10px 10px 12px;
    background: var(--bg);
    transform: rotate(-3deg);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.15),
      0 10px 24px rgba(0, 0, 0, 0.25);
  }
  .tape {
    position: absolute;
    left: -14px;
    top: -8px;
    width: 54px;
    height: 16px;
    transform: rotate(-35deg);
    background: color-mix(in srgb, var(--accent) 35%, rgba(255, 255, 255, 0.6));
    opacity: 0.85;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
  }
  /* the "photo": a sunset in accent tones */
  .photo {
    position: relative;
    height: 150px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent) 55%, #2b1a3a) 0%,
      var(--accent) 50%,
      color-mix(in srgb, var(--accent) 60%, #ffd27a) 75%,
      color-mix(in srgb, var(--accent) 45%, #1b1030) 100%
    );
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
  .sun {
    position: absolute;
    top: 28px;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, #fff2c0, color-mix(in srgb, var(--accent) 50%, #ffd27a) 70%);
    filter: blur(1px);
    opacity: 0.85;
  }
  .live {
    position: absolute;
    top: 8px;
    left: 8px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--bg);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }
  .live .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff3b30;
    animation: pf-blink 2s ease-in-out infinite;
  }
  .time {
    position: relative;
    font-size: 48px;
    line-height: 1;
    letter-spacing: 2px;
    color: var(--bg);
    text-shadow:
      0 1px 0 rgba(0, 0, 0, 0.25),
      0 4px 14px rgba(0, 0, 0, 0.35);
    font-variant-numeric: tabular-nums;
  }
  .sec {
    position: relative;
    margin-top: 2px;
    font-size: 20px;
    line-height: 1;
    letter-spacing: 2px;
    color: var(--bg);
    opacity: 0.9;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }
  /* the handwritten-style caption in the thick bottom margin */
  .caption {
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .date {
    font-size: 18px;
    letter-spacing: 3px;
    color: var(--fg);
    opacity: 0.85;
    transform: rotate(-2deg);
  }
  @keyframes pf-blink {
    50% {
      opacity: 0.35;
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".pf")) mountDigital(el);
</script>
