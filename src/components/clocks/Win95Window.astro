---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="w95"
  data-clock="win95-window"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="win">
    <div class="tbar">
      <svg class="ico" viewBox="0 0 12 12" aria-hidden="true">
        <circle cx="6" cy="6" r="5" fill="#fff" />
        <path d="M6 3v3l2 1.5" stroke="var(--accent)" stroke-width="1.3" fill="none" />
      </svg>
      <span class="ttl">Clock</span>
      <span class="live" hidden={!opts.live}>● LIVE</span>
      <span class="btns" aria-hidden="true"><b>_</b><b>□</b><b>×</b></span>
    </div>
    <div class="client">
      <div class="field">
        <div class="time"><span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>:--</span></div>
        <div class="date" hidden={!opts.date}>--/-- ---</div>
      </div>
      <div class="status">
        <span class="cell">Ready</span>
        <svg class="hg" viewBox="0 0 10 14" aria-hidden="true">
          <path d="M1 1h8L5.5 7 9 13H1l3.5-6z" fill="var(--fg)" />
          <path d="M3 2.5h4L5 6z" fill="var(--accent)" />
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .w95 {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Silkscreen", monospace;
    --lt: color-mix(in srgb, var(--bg) 45%, white);
    --dk: color-mix(in srgb, var(--bg) 50%, black);
    color: var(--fg);
  }
  .win {
    width: 240px;
    box-sizing: border-box;
    background: var(--bg);
    border: 2px solid;
    border-color: var(--lt) var(--dk) var(--dk) var(--lt);
    padding: 3px;
  }
  .tbar {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 18px;
    padding: 0 3px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 45%, #1084d0));
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }
  .ico {
    width: 12px;
    height: 12px;
  }
  .ttl {
    flex: 1;
  }
  .live {
    font-size: 8px;
    color: #fff;
    opacity: 0.9;
  }
  .btns {
    display: flex;
    gap: 2px;
  }
  .btns b {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 12px;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid;
    border-color: var(--lt) var(--dk) var(--dk) var(--lt);
    font-size: 8px;
    line-height: 1;
    font-weight: 700;
  }
  .client {
    padding: 8px 6px 4px;
  }
  .field {
    background: #fff;
    border: 2px solid;
    border-color: var(--dk) var(--lt) var(--lt) var(--dk);
    padding: 7px 8px;
    text-align: center;
  }
  .time {
    font-size: 22px;
    line-height: 1.1;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sec {
    font-size: 13px;
    font-weight: 400;
    margin-left: 2px;
    opacity: 0.75;
  }
  .date {
    font-size: 10px;
    margin-top: 4px;
    opacity: 0.8;
  }
  .status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
    font-size: 8px;
  }
  .cell {
    flex: 1;
    padding: 2px 4px;
    border: 1px solid;
    border-color: var(--dk) var(--lt) var(--lt) var(--dk);
    opacity: 0.85;
  }
  .hg {
    width: 10px;
    height: 14px;
    margin-left: 6px;
    animation: w95-flip 2s steps(1, end) infinite;
  }
  @keyframes w95-flip {
    0%,
    74% {
      transform: rotate(0deg);
    }
    75%,
    100% {
      transform: rotate(180deg);
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".w95")) mountDigital(el, { renderSeconds: (s) => ":" + s });
</script>
