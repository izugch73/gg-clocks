---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="gb"
  data-clock="game-boy"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="shell">
    <div class="bezel">
      <span class="led" aria-hidden="true"></span>
      <span class="batt" aria-hidden="true">BATTERY</span>
      <div class="screen">
        <div class="grid" aria-hidden="true"></div>
        <div class="live" hidden={!opts.live}>▶ LIVE</div>
        <div class="time">
          <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span><span class="ampm"></span>
        </div>
        <div class="date" hidden={!opts.date}>--/-- ---</div>
      </div>
      <div class="micro" aria-hidden="true">CLOCK BOY</div>
    </div>
  </div>
</div>

<style>
  .gb {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Press Start 2P", monospace;
  }
  .shell {
    width: 230px;
    padding: 10px 10px 12px;
    background: var(--fg);
    border-radius: 8px 8px 26px 8px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 -2px 0 rgba(0, 0, 0, 0.25),
      0 6px 14px rgba(0, 0, 0, 0.3);
  }
  .bezel {
    position: relative;
    padding: 12px 10px 6px 26px;
    background: color-mix(in srgb, var(--fg) 22%, #1a1a1a);
    border-radius: 6px 6px 16px 6px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.5);
  }
  .led {
    position: absolute;
    left: 10px;
    top: 44px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 5px var(--accent);
  }
  .batt {
    position: absolute;
    left: 6px;
    top: 52px;
    font-size: 4px;
    letter-spacing: 0;
    color: color-mix(in srgb, var(--fg) 60%, transparent);
  }
  /* 4-tone LCD: every shade is derived from --bg so a user bg keeps the palette */
  .screen {
    position: relative;
    overflow: hidden;
    padding: 10px 8px;
    background: var(--bg);
    color: color-mix(in srgb, var(--bg) 25%, #000);
    text-align: center;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--bg) 60%, #000);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.14);
  }
  .grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.06) 0 1px, transparent 1px 2px),
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.06) 0 1px, transparent 1px 2px);
  }
  .live {
    position: relative;
    font-size: 8px;
    margin-bottom: 8px;
    color: color-mix(in srgb, var(--bg) 45%, #000);
  }
  .time {
    position: relative;
    font-size: 20px;
    line-height: 1;
    white-space: nowrap;
  }
  .sec,
  .ampm {
    font-size: 10px;
    margin-left: 4px;
    color: color-mix(in srgb, var(--bg) 45%, #000);
  }
  .ampm:empty {
    display: none;
  }
  .date {
    position: relative;
    margin-top: 8px;
    font-size: 8px;
    color: color-mix(in srgb, var(--bg) 40%, #000);
  }
  .micro {
    margin-top: 5px;
    font-size: 7px;
    font-style: italic;
    letter-spacing: 1px;
    color: color-mix(in srgb, var(--fg) 70%, transparent);
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".gb")) mountDigital(el);
</script>
