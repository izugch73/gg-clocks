---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="spr"
  data-clock="split-rule"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="row">
    <span class="hm">--:--</span>
    <span class="rule" aria-hidden="true"></span>
    <div class="col">
      <span class="live" hidden={!opts.live}>LIVE</span>
      <span class="date" hidden={!opts.date}>--/-- ---</span>
      <span class="sec" hidden={!opts.seconds}>--</span>
    </div>
  </div>
</div>

<style>
  .spr {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    color: var(--fg);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 14px;
    border-radius: 10px;
    background: var(--bg);
    line-height: 1;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
  }
  .hm {
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -0.5px;
    font-variant-numeric: tabular-nums;
  }
  .rule {
    align-self: stretch;
    width: 2px;
    border-radius: 1px;
    background: var(--accent);
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: 13px;
    font-weight: 600;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }
  .live {
    color: var(--accent);
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 2px;
  }
  /* Rule and column disappear together when nothing is shown on the right. */
  .row:not(:has(.col > :not([hidden]))) .rule,
  .row:not(:has(.col > :not([hidden]))) .col {
    display: none;
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".spr")) mountDigital(el);
</script>
