---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="fw"
  data-clock="furin-wind-chime"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <svg class="bell" viewBox="0 0 80 80" width="80" height="80" aria-hidden="true">
    <defs>
      <radialGradient id="fw-glass" cx="38%" cy="30%" r="70%">
        <stop class="g1" offset="0%"></stop>
        <stop class="g2" offset="55%"></stop>
        <stop class="g3" offset="100%"></stop>
      </radialGradient>
    </defs>
    <circle class="ring" cx="40" cy="7" r="5"></circle>
    <line class="str" x1="40" y1="12" x2="40" y2="28"></line>
    <path class="glass" d="M40 28 C20 29 13 46 15 62 Q40 72 65 62 C67 46 60 29 40 28 Z"></path>
    <path class="sheen" d="M27 38 C23 43 22 50 23 56"></path>
    <path class="rim" d="M15 62 Q40 72 65 62"></path>
    <line class="str" x1="40" y1="52" x2="40" y2="80"></line>
    <circle class="clapper" cx="40" cy="58" r="3"></circle>
  </svg>
  <div class="bar" aria-hidden="true"></div>
  <div class="strips">
    <div class="strip side s1" aria-hidden="true"></div>
    <div class="strip main">
      <span class="hm">--:--</span>
      <span class="sec" hidden={!opts.seconds}>--</span>
      <span class="date" hidden={!opts.date}>--/-- ---</span>
      <span class="live" hidden={!opts.live}>LIVE</span>
    </div>
    <div class="strip side s2" aria-hidden="true"></div>
  </div>
</div>

<style>
  .fw {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Zen Kaku Gothic New", sans-serif;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    color: var(--fg);
  }
  .bell {
    display: block;
    overflow: visible;
    transform-origin: 40px 7px;
    animation: fw-bob 5s ease-in-out infinite;
  }
  .g1 { stop-color: color-mix(in srgb, var(--bg) 55%, #fff); }
  .g2 { stop-color: var(--bg); }
  .g3 { stop-color: color-mix(in srgb, var(--fg) 30%, var(--bg)); }
  .ring,
  .rim,
  .sheen {
    fill: none;
    stroke: var(--fg);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .str {
    stroke: var(--fg);
    stroke-width: 1;
  }
  .glass {
    fill: url(#fw-glass);
    stroke: color-mix(in srgb, var(--fg) 70%, transparent);
    stroke-width: 1.4;
  }
  .sheen {
    stroke: #fff;
    stroke-width: 2.5;
    opacity: 0.55;
  }
  .clapper {
    fill: var(--fg);
  }
  .bar {
    width: 56px;
    height: 4px;
    margin-top: -1px;
    border-radius: 2px;
    background: var(--fg);
  }
  .strips {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .strip {
    transform-origin: 50% 0;
    animation: fw-swing 3.8s ease-in-out infinite;
  }
  .side {
    width: 18px;
    min-height: 64px;
    background: var(--accent);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 92%, 0 100%);
  }
  .s1 { animation-delay: -1.2s; }
  .s2 { animation-delay: -2.4s; }
  /* the widest tanzaku: paper strip with accent bands, time in fg (kept legible) */
  .main {
    width: 140px;
    min-height: 64px;
    padding: 12px 8px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    background: var(--bg);
    border: 1px solid color-mix(in srgb, var(--fg) 25%, transparent);
    box-shadow:
      inset 0 5px 0 var(--accent),
      inset 0 -5px 0 var(--accent),
      0 3px 8px rgba(0, 0, 0, 0.18);
    text-align: center;
    line-height: 1.1;
  }
  .hm {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
  }
  .sec {
    font-size: 14px;
    font-weight: 500;
    opacity: 0.8;
  }
  .date {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1px;
    opacity: 0.85;
  }
  .live {
    margin-top: 2px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--accent);
  }
  @keyframes fw-swing {
    0%,
    100% {
      transform: rotate(-2.5deg);
    }
    50% {
      transform: rotate(2.5deg);
    }
  }
  @keyframes fw-bob {
    0%,
    100% {
      transform: rotate(-1deg);
    }
    50% {
      transform: rotate(1deg);
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".fw")) mountDigital(el);
</script>
