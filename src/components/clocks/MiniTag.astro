---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="mt"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="tag">
    <span class="dot live" hidden={!opts.live} aria-hidden="true"></span>
    <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
    <span class="sep" data-with="date" hidden={!opts.date} aria-hidden="true">|</span>
    <span class="date" hidden={!opts.date}>--/--</span>
  </div>
</div>

<style>
  .mt {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Share Tech Mono", "Menlo", monospace;
    padding: 2px;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: var(--bg);
    color: var(--fg);
    border-radius: 4px;
    font-size: 13px;
    line-height: 1;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: mt-pulse 1.2s ease-in-out infinite;
  }
  .sec {
    margin-left: 2px;
    opacity: 0.7;
    font-size: 11px;
  }
  .sep {
    opacity: 0.4;
  }
  .date {
    opacity: 0.75;
    font-size: 11px;
    letter-spacing: 0.5px;
  }
  @keyframes mt-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".mt")) {
    mountDigital(el, { renderDate: (p) => `${p.month}/${p.day}` });
  }
</script>
