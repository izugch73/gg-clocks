---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="mt"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="tag">
    <span class="dot" hidden={!opts.live} aria-hidden="true"></span>
    <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
    <span class="sep" hidden={!opts.date} aria-hidden="true">|</span>
    <span class="date" hidden={!opts.date}>--/--</span>
  </div>
</div>

<style>
  .mt {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Share Tech Mono", "Menlo", monospace;
    padding: 2px;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: var(--bg);
    color: var(--fg);
    border-radius: 4px;
    font-size: 13px;
    line-height: 1;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: mt-pulse 1.2s ease-in-out infinite;
  }
  .sec {
    margin-left: 2px;
    opacity: 0.7;
    font-size: 11px;
  }
  .sep {
    opacity: 0.4;
  }
  .date {
    opacity: 0.75;
    font-size: 11px;
    letter-spacing: 0.5px;
  }
  @keyframes mt-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
</style>

<script>
  type Lang = "ja" | "en";
  function partsFor(tz: string) {
    const f = new Intl.DateTimeFormat("en-US", {
      timeZone: tz, hour12: false,
      month: "2-digit", day: "2-digit",
      hour: "2-digit", minute: "2-digit", second: "2-digit",
      weekday: "short",
    });
    return Object.fromEntries(f.formatToParts(new Date()).map((p) => [p.type, p.value])) as Record<string, string>;
  }
  function wd(en: string | undefined, lang: Lang): string {
    if (!en) return "";
    if (lang === "en") return en.toUpperCase();
    return { Sun: "日", Mon: "月", Tue: "火", Wed: "水", Thu: "木", Fri: "金", Sat: "土" }[en] ?? "";
  }
  function init(el: HTMLElement) {
    const tz = el.dataset.tz || "Asia/Tokyo";
    const lang = (el.dataset.lang as Lang) || "ja";
    const format = el.dataset.format || "24";
    const hmEl = el.querySelector<HTMLElement>(".hm");
    const secEl = el.querySelector<HTMLElement>(".sec");
    const dateEl = el.querySelector<HTMLElement>(".date");
    if (!hmEl) return;
    function tick() {
      const p = partsFor(tz);
      let hour = p.hour;
      let suffix = "";
      if (format === "12") {
        const h = Number(hour);
        hour = String(((h + 11) % 12) + 1).padStart(2, "0");
        suffix = h >= 12 ? " PM" : " AM";
      }
      if (hmEl) hmEl.textContent = `${hour}:${p.minute}${suffix}`;
      if (secEl) secEl.textContent = p.second ?? "";
      if (dateEl) dateEl.textContent = `${p.month}/${p.day}`;
    }
    tick();
    setInterval(tick, 1000);
  }
  for (const el of document.querySelectorAll<HTMLElement>(".mt")) init(el);
</script>
