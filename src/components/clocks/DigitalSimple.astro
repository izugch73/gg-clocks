---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="di"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="bar">
    <div class="live" hidden={!opts.live}>
      <span class="dot" aria-hidden="true"></span>LIVE
    </div>
    <div class="time">
      <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
    </div>
    <div class="sep" aria-hidden="true"></div>
    <div class="date" hidden={!opts.date}>--/-- ---</div>
  </div>
</div>

<style>
  .di {
    color: var(--fg);
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Roboto", system-ui, sans-serif;
  }
  .bar {
    background: var(--bg);
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 8px 16px;
    border-radius: 999px;
    font-weight: 700;
    letter-spacing: 1.5px;
    line-height: 1;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.2);
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 12px;
    letter-spacing: 1.5px;
  }
  .live .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    animation: di-pulse 1.2s ease-in-out infinite;
  }
  .time {
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .time .sec {
    font-size: 14px;
    font-weight: 700;
    opacity: 0.7;
  }
  .sep {
    width: 1px;
    height: 20px;
    background: currentColor;
    opacity: 0.25;
  }
  .date {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.85;
  }
  @keyframes di-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }
</style>

<script>
  type Lang = "ja" | "en";

  function partsFor(tz: string) {
    const f = new Intl.DateTimeFormat("en-US", {
      timeZone: tz,
      hour12: false,
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      weekday: "short",
    });
    return Object.fromEntries(f.formatToParts(new Date()).map((p) => [p.type, p.value])) as Record<
      string,
      string
    >;
  }

  function wd(en: string | undefined, lang: Lang): string {
    if (!en) return "";
    if (lang === "en") return en.toUpperCase();
    return { Sun: "日", Mon: "月", Tue: "火", Wed: "水", Thu: "木", Fri: "金", Sat: "土" }[en] ?? "";
  }

  function init(el: HTMLElement) {
    const tz = el.dataset.tz || "Asia/Tokyo";
    const lang = (el.dataset.lang as Lang) || "ja";
    const format = el.dataset.format || "24";
    const hmEl = el.querySelector<HTMLElement>(".hm");
    const secEl = el.querySelector<HTMLElement>(".sec");
    const dateEl = el.querySelector<HTMLElement>(".date");
    if (!hmEl) return;

    function tick() {
      const p = partsFor(tz);
      let hour = p.hour;
      let ampm = "";
      if (format === "12") {
        const h = Number(hour);
        const h12 = ((h + 11) % 12) + 1;
        hour = String(h12).padStart(2, "0");
        ampm = h >= 12 ? " PM" : " AM";
      }
      if (hmEl) hmEl.textContent = `${hour}:${p.minute}${ampm}`;
      if (secEl) secEl.textContent = p.second ?? "";
      if (dateEl) dateEl.textContent = `${p.month}.${p.day} ${wd(p.weekday, lang)}`;
    }
    tick();
    setInterval(tick, 1000);
  }

  for (const el of document.querySelectorAll<HTMLElement>(".di")) init(el);
</script>
