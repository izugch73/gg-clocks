---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="di"
  data-clock="digital-simple"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="bar">
    <div class="live" hidden={!opts.live}>
      <span class="dot" aria-hidden="true"></span>LIVE
    </div>
    <div class="time">
      <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
    </div>
    <div class="sep" data-with="date" hidden={!opts.date} aria-hidden="true"></div>
    <div class="date" hidden={!opts.date}>--/-- ---</div>
  </div>
</div>

<style>
  .di {
    color: var(--fg);
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Roboto", system-ui, sans-serif;
  }
  .bar {
    background: var(--bg);
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 8px 16px;
    border-radius: 999px;
    font-weight: 700;
    letter-spacing: 1.5px;
    line-height: 1;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.2);
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 12px;
    letter-spacing: 1.5px;
  }
  .live .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    animation: di-pulse 1.2s ease-in-out infinite;
  }
  .time {
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .time .sec {
    font-size: 14px;
    font-weight: 700;
    opacity: 0.7;
  }
  .sep {
    width: 1px;
    height: 20px;
    background: currentColor;
    opacity: 0.25;
  }
  .date {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.85;
  }
  @keyframes di-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".di")) mountDigital(el);
</script>
