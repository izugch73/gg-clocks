---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
const C = 120;
---

<div
  class="db"
  data-clock="diver-bezel"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <svg viewBox="0 0 240 240" width="240" height="240" aria-hidden="true">
    <circle cx={C} cy={C} r="118" class="bezel" />
    {Array.from({ length: 60 }).map((_, i) =>
      i === 0 ? null : (
        <line
          x1={C}
          y1="4"
          x2={C}
          y2={i % 5 === 0 ? 10 : 8}
          class={i % 5 === 0 ? "bz-tick bz-major" : "bz-tick"}
          transform={`rotate(${i * 6} ${C} ${C})`}
        />
      ),
    )}
    {Array.from({ length: 11 }).map((_, k) => {
      const m = (k + 1) * 5;
      const a = (m / 60) * Math.PI * 2 - Math.PI / 2;
      return (
        <text x={C + Math.cos(a) * 109} y={C + Math.sin(a) * 109} class="bz-num" text-anchor="middle" dominant-baseline="central">
          {m}
        </text>
      );
    })}
    <path d={`M${C} 3 L${C - 7} 16 L${C + 7} 16 Z`} class="pip" />
    <circle cx={C} cy={C} r="100" class="face" />
    <circle cx={C} cy={C} r="97" class="chapter" />

    {Array.from({ length: 60 }).map((_, i) => (
      <line x1={C} y1="26" x2={C} y2="30" class="min-tick" transform={`rotate(${i * 6} ${C} ${C})`} />
    ))}
    {Array.from({ length: 12 }).map((_, i) => {
      const a = (i / 12) * Math.PI * 2 - Math.PI / 2;
      const x = C + Math.cos(a) * 84;
      const y = C + Math.sin(a) * 84;
      return i === 0 ? (
        <path d={`M${x - 8} ${y - 10} L${x + 8} ${y - 10} L${x} ${y + 6} Z`} class="lume" style="animation-delay:0s" />
      ) : (
        <circle cx={x} cy={y} r={i % 3 === 0 ? 7 : 5.5} class="lume" style={`animation-delay:${-i * 0.25}s`} />
      );
    })}

    {/* Mercedes-style hand set */}
    <g class="hand-h">
      <line x1={C} y1={C + 14} x2={C} y2={C - 42} class="hand hand-hour" />
      <circle cx={C} cy={C - 50} r="9" class="hand-cap" />
      <path d={`M${C} ${C - 50} L${C} ${C - 58} M${C} ${C - 50} L${C - 7} ${C - 46} M${C} ${C - 50} L${C + 7} ${C - 46}`} class="merc" />
      <line x1={C} y1={C - 59} x2={C} y2={C - 68} class="hand hand-hour-tip" />
    </g>
    <g class="hand-m">
      <line x1={C} y1={C + 16} x2={C} y2={C - 86} class="hand hand-min" />
      <line x1={C} y1={C - 30} x2={C} y2={C - 76} class="lume-stripe" />
    </g>
    <g class="hand-s sec" {...(opts.seconds ? {} : { hidden: true })}>
      <line x1={C} y1={C + 22} x2={C} y2={C - 88} class="hand-sec" />
      <circle cx={C} cy={C - 62} r="4" class="sec-lume" />
    </g>
    <circle cx={C} cy={C} r="5" class="pin" />
    <circle cx={C} cy={C} r="2" class="pin-center" />
  </svg>
</div>

<style>
  .db {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    --lume: color-mix(in srgb, var(--accent) 35%, white);
    --on-bezel: color-mix(in srgb, var(--bg) 85%, var(--fg));
  }
  .db svg {
    display: block;
  }
  .bezel {
    fill: var(--fg);
  }
  .bz-tick {
    stroke: var(--on-bezel);
    stroke-width: 1.5;
  }
  .bz-major {
    stroke-width: 2.5;
  }
  .bz-num {
    font-family: "Oswald", sans-serif;
    font-weight: 700;
    font-size: 11px;
    fill: var(--on-bezel);
  }
  .pip {
    fill: var(--accent);
  }
  .face {
    fill: var(--bg);
    stroke: color-mix(in srgb, var(--fg) 50%, transparent);
    stroke-width: 1;
  }
  .chapter {
    fill: none;
    stroke: color-mix(in srgb, var(--fg) 25%, transparent);
    stroke-width: 1;
  }
  .min-tick {
    stroke: var(--fg);
    stroke-width: 1.2;
    opacity: 0.6;
  }
  .lume {
    fill: var(--lume);
    stroke: var(--fg);
    stroke-width: 1;
    filter: drop-shadow(0 0 3px var(--accent));
    animation: db-glow 3s ease-in-out infinite;
  }
  .hand {
    stroke: var(--fg);
    stroke-linecap: round;
  }
  .hand-hour {
    stroke-width: 6;
  }
  .hand-hour-tip {
    stroke-width: 4;
  }
  .hand-cap {
    fill: var(--lume);
    stroke: var(--fg);
    stroke-width: 2;
  }
  .merc {
    stroke: var(--fg);
    stroke-width: 2;
    fill: none;
  }
  .hand-min {
    stroke-width: 5;
  }
  .lume-stripe {
    stroke: var(--lume);
    stroke-width: 2;
  }
  .hand-sec {
    stroke: var(--lume);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .sec-lume {
    fill: var(--lume);
    stroke: var(--fg);
    stroke-width: 1;
  }
  .pin {
    fill: var(--fg);
  }
  .pin-center {
    fill: var(--accent);
  }
  .hand-h,
  .hand-m,
  .hand-s {
    transform-origin: 120px 120px;
    transition: transform 0.2s cubic-bezier(0.4, 2.2, 0.6, 1);
  }
  .hand-s {
    transition: transform 0.15s cubic-bezier(0.4, 2.2, 0.6, 1);
  }
  @keyframes db-glow {
    0%,
    100% {
      filter: drop-shadow(0 0 2px var(--accent));
    }
    50% {
      filter: drop-shadow(0 0 6px var(--accent));
    }
  }
</style>

<script>
  import { mountAnalog } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".db")) mountAnalog(el);
</script>
