---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
// Earthly branches clockwise from the top: 午 (noon) at 12, 子 (midnight) at 6.
const BRANCHES = ["午", "未", "申", "酉", "戌", "亥", "子", "丑", "寅", "卯", "辰", "巳"];
const C = 100;
const pos = (deg: number, r: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return { x: C + Math.cos(a) * r, y: C + Math.sin(a) * r };
};
---

<div
  class="wd"
  data-clock="wadokei-dial"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <svg viewBox="0 0 200 200" width="200" height="200" aria-hidden="true">
    <circle cx={C} cy={C} r="98" class="rim" />
    <circle cx={C} cy={C} r="90" class="face" />
    <circle cx={C} cy={C} r="84" class="ring" />
    <circle cx={C} cy={C} r="56" class="ring thin" />

    {BRANCHES.map((ch, i) => {
      const p = pos(i * 30, 70);
      return (
        <text x={p.x} y={p.y} class="num" text-anchor="middle" dominant-baseline="central">{ch}</text>
      );
    })}
    {Array.from({ length: 12 }).map((_, i) => {
      const p = pos(i * 30 + 15, 70);
      return <circle cx={p.x} cy={p.y} r="1.6" class="dot" />;
    })}
    {Array.from({ length: 24 }).map((_, i) => {
      const p = pos(i * 15, 50);
      return <circle cx={p.x} cy={p.y} r={i % 2 === 0 ? 1.8 : 1} class="dot" />;
    })}

    <g class="hand-h">
      <path class="hour" d="M100 114 L93 102 L97 98 L99 62 L100 54 L101 62 L103 98 L107 102 Z" />
      <circle cx="100" cy="80" r="2.2" class="hour-eye" />
    </g>
    <g class="hand-m">
      <line x1="100" y1="116" x2="100" y2="30" class="minute" />
    </g>
    <g class="hand-s sec" {...(opts.seconds ? {} : { hidden: true })}>
      <line x1="100" y1="120" x2="100" y2="26" class="second" />
    </g>
    <circle cx={C} cy={C} r="7" class="boss" />
    <circle cx={C} cy={C} r="2.5" class="boss-center" />
  </svg>
  <span class="hm" hidden>--:--</span>
  <span class="live" hidden={!opts.live}>LIVE</span>
  <span class="date" hidden={!opts.date}>--/-- ---</span>
</div>

<style>
  .wd {
    position: relative;
    width: 200px;
    height: 200px;
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Noto Serif JP", serif;
    color: var(--fg);
  }
  .wd svg {
    display: block;
  }
  .rim {
    fill: var(--accent);
  }
  .face {
    fill: var(--bg);
    stroke: color-mix(in srgb, var(--accent) 60%, transparent);
    stroke-width: 1;
  }
  .ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
    opacity: 0.8;
  }
  .ring.thin {
    stroke-width: 0.6;
    opacity: 0.45;
  }
  .num {
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    font-size: 15px;
    fill: var(--fg);
  }
  .dot {
    fill: var(--accent);
    opacity: 0.85;
  }
  .hour {
    fill: var(--accent);
    stroke: color-mix(in srgb, var(--bg) 60%, transparent);
    stroke-width: 0.6;
  }
  .hour-eye {
    fill: var(--bg);
  }
  .minute {
    stroke: var(--fg);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .second {
    stroke: var(--accent);
    stroke-width: 0.9;
    stroke-linecap: round;
    opacity: 0.9;
  }
  .boss {
    fill: var(--accent);
  }
  .boss-center {
    fill: var(--bg);
  }
  .hand-h,
  .hand-m,
  .hand-s {
    transform-origin: 100px 100px;
    transition: transform 0.25s cubic-bezier(0.4, 1.8, 0.6, 1);
  }
  .live,
  .date {
    position: absolute;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    font-variant-numeric: tabular-nums;
  }
  .live {
    top: 54px;
    color: var(--accent);
    font-size: 9px;
    letter-spacing: 2px;
  }
  .date {
    top: 126px;
    color: var(--fg);
    opacity: 0.85;
  }
</style>

<script>
  import { mountAnalog, mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".wd")) {
    mountAnalog(el);
    mountDigital(el);
  }
</script>
