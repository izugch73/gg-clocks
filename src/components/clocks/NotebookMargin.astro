---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="nb"
  data-clock="notebook-margin"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="page">
    <i class="fold" aria-hidden="true"></i>
    <div class="line1">
      <span class="scribble">
        <svg class="loop" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
          <path
            pathLength="100"
            d="M 8 22 C 6 4 40 2 60 4 C 86 6 98 14 96 24 C 94 36 60 40 36 38 C 14 36 2 30 6 20 C 10 8 44 4 66 6 C 88 8 97 16 94 26"
          ></path>
        </svg>
        <span class="hm">--:--</span>
      </span>
      <span class="sec" hidden={!opts.seconds}>--</span>
    </div>
    <div class="line2">
      <span class="date" hidden={!opts.date}>--/-- ---</span>
      <span class="live" hidden={!opts.live}>LIVE!</span>
    </div>
  </div>
</div>

<style>
  .nb {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Caveat", cursive;
    color: var(--fg);
  }
  /* ruled page: blue-ish rules every 22px, accent margin rule, three punched holes cut by a mask */
  .page {
    position: relative;
    width: 240px;
    height: 130px;
    padding: 10px 12px 0 46px;
    background-color: var(--bg);
    background-image:
      linear-gradient(90deg, transparent 36px, var(--accent) 36px, var(--accent) 37px, transparent 37px),
      repeating-linear-gradient(180deg, transparent 0 21px, color-mix(in srgb, var(--fg) 22%, transparent) 21px 22px);
    clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 0 100%);
    -webkit-mask-image:
      radial-gradient(circle 5px at 14px 26px, transparent 98%, #000 100%),
      radial-gradient(circle 5px at 14px 65px, transparent 98%, #000 100%),
      radial-gradient(circle 5px at 14px 104px, transparent 98%, #000 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(circle 5px at 14px 26px, transparent 98%, #000 100%),
      radial-gradient(circle 5px at 14px 65px, transparent 98%, #000 100%),
      radial-gradient(circle 5px at 14px 104px, transparent 98%, #000 100%);
    mask-composite: intersect;
  }
  /* dog-eared top-right corner */
  .fold {
    position: absolute;
    top: 0;
    right: 0;
    width: 16px;
    height: 16px;
    background: linear-gradient(to bottom left, transparent 50%, color-mix(in srgb, var(--fg) 18%, var(--bg)) 50%);
  }
  .line1 {
    display: flex;
    align-items: baseline;
    gap: 8px;
    line-height: 40px;
  }
  .scribble {
    position: relative;
    display: inline-block;
  }
  .loop {
    position: absolute;
    inset: -2px -10px 0 -8px;
    width: calc(100% + 18px);
    height: calc(100% + 2px);
    overflow: visible;
  }
  .loop path {
    fill: none;
    stroke: color-mix(in srgb, var(--fg) 55%, transparent);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: nb-draw 1.4s ease-out 0.3s forwards;
  }
  .hm {
    position: relative;
    font-size: 42px;
    font-weight: 700;
    letter-spacing: 1px;
  }
  .sec {
    font-size: 22px;
    font-weight: 400;
    opacity: 0.8;
  }
  .line2 {
    display: flex;
    align-items: baseline;
    gap: 12px;
    line-height: 22px;
    margin-top: 2px;
    font-size: 21px;
  }
  .date {
    opacity: 0.85;
  }
  .live {
    color: var(--accent);
    font-weight: 700;
    text-decoration: underline wavy;
    text-underline-offset: 3px;
  }
  @keyframes nb-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".nb")) mountDigital(el);
</script>
