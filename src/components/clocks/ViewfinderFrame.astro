---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="vff"
  data-clock="viewfinder-frame"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="frame">
    <i class="c tl" aria-hidden="true"></i><i class="c tr" aria-hidden="true"></i>
    <i class="c bl" aria-hidden="true"></i><i class="c br" aria-hidden="true"></i>
    <div class="rec">
      <span class="dot" data-with="live" hidden={!opts.live} aria-hidden="true"></span>
      <span class="live" hidden={!opts.live}>REC</span>
    </div>
    <div class="row">
      <span class="hm">--:--</span>
      <span class="ampm"></span>
      <span class="sec" hidden={!opts.seconds}>--</span>
    </div>
    <span class="date" hidden={!opts.date}>--/-- ---</span>
  </div>
</div>

<style>
  .vff {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Roboto", system-ui, sans-serif;
    color: var(--fg);
  }
  .frame {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 240px;
    min-height: 90px;
    padding: 22px 24px 18px;
    background: var(--bg);
  }
  .c {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 0 solid var(--fg);
  }
  .tl { top: 0; left: 0; border-width: 2px 0 0 2px; }
  .tr { top: 0; right: 0; border-width: 2px 2px 0 0; }
  .bl { bottom: 0; left: 0; border-width: 0 0 2px 2px; }
  .br { bottom: 0; right: 0; border-width: 0 2px 2px 0; }
  .rec {
    position: absolute;
    top: 8px;
    right: 12px;
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    line-height: 1;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: vff-blink 1s linear infinite;
  }
  .live {
    color: var(--accent);
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    line-height: 1;
  }
  .hm {
    font-size: 40px;
    font-weight: 700;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
  }
  .ampm,
  .sec {
    font-size: 16px;
    font-weight: 500;
    opacity: 0.65;
    font-variant-numeric: tabular-nums;
  }
  .ampm:empty {
    display: none;
  }
  .date {
    font-size: 12px;
    font-weight: 500;
    font-variant: small-caps;
    letter-spacing: 2px;
    opacity: 0.8;
    line-height: 1;
  }
  @keyframes vff-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".vff")) mountDigital(el);
</script>
