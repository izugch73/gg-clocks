---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="cs"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="label">
    <div class="paper" aria-hidden="true"></div>
    <div class="header">
      <span class="side">SIDE A</span>
      <span class="brand">on_air radio</span>
      <span class="live" hidden={!opts.live}>● REC</span>
    </div>
    <div class="row title">
      <span class="meta">TRACK 01</span>
      <span class="hm">--:--</span>
      <span class="sec" hidden={!opts.seconds}>--</span>
    </div>
    <div class="hr" data-with="date" hidden={!opts.date}></div>
    <div class="row sub date" hidden={!opts.date}>
      <span class="meta">DATE</span>
      <span class="dv">--/-- ---</span>
    </div>
  </div>
</div>

<style>
  .cs {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
  }
  .label {
    position: relative;
    width: 280px;
    background: var(--bg);
    color: var(--fg);
    border: 2px solid color-mix(in srgb, var(--fg) 85%, transparent);
    border-radius: 2px;
    padding: 12px 16px 14px;
    box-shadow:
      0 6px 14px rgba(0, 0, 0, 0.16),
      inset 0 0 0 1px rgba(255, 255, 255, 0.5);
    overflow: hidden;
  }
  /* paper grain via repeating tiny radial-gradients */
  .paper {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(0, 0, 0, 0.04) 0 0.6px, transparent 1.5px),
      radial-gradient(circle at 65% 70%, rgba(0, 0, 0, 0.04) 0 0.6px, transparent 1.5px),
      radial-gradient(circle at 80% 20%, rgba(0, 0, 0, 0.04) 0 0.5px, transparent 1.4px),
      radial-gradient(circle at 30% 80%, rgba(0, 0, 0, 0.05) 0 0.5px, transparent 1.4px);
    background-size: 7px 7px, 11px 11px, 5px 5px, 9px 9px;
    opacity: 0.9;
  }
  .header {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 65%, transparent);
    padding-bottom: 6px;
    border-bottom: 1px dashed color-mix(in srgb, var(--fg) 30%, transparent);
  }
  .side {
    font-weight: 800;
    color: var(--accent);
  }
  .brand {
    flex: 1;
    text-align: center;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    text-transform: none;
    letter-spacing: 0.5px;
    font-style: italic;
    color: color-mix(in srgb, var(--fg) 75%, transparent);
  }
  .live {
    color: var(--accent);
    font-weight: 800;
  }
  .row {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 8px;
  }
  .row.title {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
  }
  .row.sub {
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 75%, transparent);
  }
  .meta {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 700;
    color: color-mix(in srgb, var(--fg) 55%, transparent);
    margin-right: 2px;
  }
  .row.title .meta {
    align-self: center;
  }
  .sec {
    margin-left: 4px;
    font-size: 18px;
    font-weight: 700;
    opacity: 0.65;
  }
  .hr {
    position: relative;
    height: 1px;
    margin: 6px 0 0;
    background: repeating-linear-gradient(
      90deg,
      color-mix(in srgb, var(--fg) 35%, transparent) 0 6px,
      transparent 6px 12px
    );
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".cs")) mountDigital(el, { dateSelector: ".date .dv" });
</script>
