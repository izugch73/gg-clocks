---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
// Dial centre of the dome
const C = { x: 90, y: 100 };
---

<div
  class="kt"
  data-clock="kitchen-timer"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <svg viewBox="0 0 180 190" width="180" height="190" aria-hidden="true">
    <defs>
      <clipPath id="kt-dome"><rect x="0" y="0" width="180" height="176" /></clipPath>
      <radialGradient id="kt-shine" cx="40%" cy="22%" r="60%">
        <stop offset="0%" stop-color="white" stop-opacity="0.45" />
        <stop offset="100%" stop-color="white" stop-opacity="0" />
      </radialGradient>
    </defs>
    {/* knob, base, then the dome (circle with a flat bottom) */}
    <rect x="80" y="6" width="20" height="18" rx="4" class="knob" />
    <rect x="46" y="170" width="88" height="14" rx="5" class="base" />
    <g clip-path="url(#kt-dome)">
      <circle cx={C.x} cy={C.y} r="84" class="shell" />
      <circle cx={C.x} cy={C.y} r="84" fill="url(#kt-shine)" />
    </g>
    <circle cx={C.x} cy={C.y} r="63" class="face" />

    {Array.from({ length: 60 }).map((_, i) => (
      <line
        x1={C.x}
        y1={C.y - 60}
        x2={C.x}
        y2={C.y - (i % 5 === 0 ? 54 : 57)}
        class={i % 5 === 0 ? "tick tick-major" : "tick"}
        transform={`rotate(${i * 6} ${C.x} ${C.y})`}
      />
    ))}
    {Array.from({ length: 12 }).map((_, i) => {
      const a = (i / 12) * Math.PI * 2 - Math.PI / 2;
      return (
        <text x={C.x + Math.cos(a) * 45} y={C.y + Math.sin(a) * 45} class="num" text-anchor="middle" dominant-baseline="central">
          {i * 5}
        </text>
      );
    })}

    <g class="hand-h">
      <line x1={C.x} y1={C.y + 8} x2={C.x} y2={C.y - 30} class="hand hand-hour" />
    </g>
    <g class="hand-m">
      <line x1={C.x} y1={C.y + 10} x2={C.x} y2={C.y - 48} class="hand hand-min" />
    </g>
    <g class="hand-s sec" {...(opts.seconds ? {} : { hidden: true })}>
      <line x1={C.x} y1={C.y + 12} x2={C.x} y2={C.y - 52} class="hand-sec" />
    </g>
    <circle cx={C.x} cy={C.y} r="5" class="pin" />
    <circle cx={C.x} cy={C.y} r="2" class="pin-center" />
  </svg>
</div>

<style>
  .kt {
    transform: scale(var(--scale, 1));
    transform-origin: center;
  }
  .kt svg {
    display: block;
  }
  .knob,
  .base {
    fill: var(--fg);
  }
  .shell {
    fill: var(--accent);
  }
  .face {
    fill: var(--bg);
    stroke: color-mix(in srgb, var(--accent) 65%, var(--fg));
    stroke-width: 4;
  }
  .tick {
    stroke: var(--fg);
    stroke-width: 1.2;
    opacity: 0.45;
  }
  .tick-major {
    stroke-width: 2.2;
    opacity: 0.9;
  }
  .num {
    font-family: "Fredoka", sans-serif;
    font-weight: 700;
    font-size: 11px;
    fill: var(--fg);
  }
  .hand {
    stroke: var(--fg);
    stroke-linecap: round;
  }
  .hand-hour {
    stroke-width: 7;
  }
  .hand-min {
    stroke-width: 5;
  }
  .hand-sec {
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .pin {
    fill: var(--fg);
  }
  .pin-center {
    fill: var(--accent);
  }
  .hand-h,
  .hand-m,
  .hand-s {
    transform-origin: 90px 100px;
    transition: transform 0.2s cubic-bezier(0.4, 2.2, 0.6, 1);
  }
  .hand-s {
    transition: transform 0.15s cubic-bezier(0.4, 2.2, 0.6, 1);
  }
</style>

<script>
  import { mountAnalog } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".kt")) mountAnalog(el);
</script>
