---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
// Needle pivot sits below the visible window; scale spans -50°..+50°
const PX = 110;
const PY = 118;
const R = 96;
const pt = (deg: number, r: number) => ({
  x: PX + Math.sin((deg * Math.PI) / 180) * r,
  y: PY - Math.cos((deg * Math.PI) / 180) * r,
});
const arc = (a0: number, a1: number, r: number) => {
  const p0 = pt(a0, r);
  const p1 = pt(a1, r);
  return `M${p0.x} ${p0.y} A${r} ${r} 0 0 1 ${p1.x} ${p1.y}`;
};
const labels = [
  { a: -50, t: "-20" },
  { a: -32, t: "-10" },
  { a: -18, t: "-5" },
  { a: -8, t: "-3" },
  { a: 10, t: "0" },
  { a: 34, t: "+3" },
];
const minors = Array.from({ length: 26 }).map((_, i) => -50 + i * 4);
---

<div
  class="vu"
  data-clock="vu-meter"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="panel">
    <div class="window">
      <svg viewBox="0 0 220 96" width="244" height="106" aria-hidden="true">
        <path d={arc(-50, 50, R)} class="scale" />
        <path d={arc(10, 50, R)} class="red" />
        {minors.map((a) => {
          const o = pt(a, R);
          const i = pt(a, R - 5);
          return <line x1={o.x} y1={o.y} x2={i.x} y2={i.y} class={`minor${a >= 10 ? " red" : ""}`} />;
        })}
        {labels.map((l) => {
          const o = pt(l.a, R + 1);
          const i = pt(l.a, R - 9);
          const tp = pt(l.a, R - 17);
          return (
            <>
              <line x1={o.x} y1={o.y} x2={i.x} y2={i.y} class={`major${l.a >= 10 ? " red" : ""}`} />
              <text x={tp.x} y={tp.y} class={`lbl${l.a >= 10 ? " red" : ""}`} text-anchor="middle" dominant-baseline="central">
                {l.t}
              </text>
            </>
          );
        })}
        <text x={PX} y="78" class="vu-mark" text-anchor="middle" dominant-baseline="central">VU</text>
        <line x1={PX} y1={PY} x2={PX} y2="26" class="needle" />
      </svg>
      <span class="live" hidden={!opts.live}>● LIVE</span>
    </div>
    <div class="strip">
      <span class="time"><span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span></span>
      <span class="date" hidden={!opts.date}>--/-- ---</span>
    </div>
  </div>
</div>

<style>
  .vu {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Share Tech Mono", "Menlo", monospace;
    color: var(--fg);
  }
  .panel {
    width: 260px;
    box-sizing: border-box;
    padding: 8px;
    background: var(--bg);
    border-radius: 10px;
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--fg) 25%, transparent),
      0 8px 20px rgba(0, 0, 0, 0.25);
  }
  .window {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    background: color-mix(in srgb, var(--bg) 92%, var(--fg));
    box-shadow:
      inset 0 2px 6px rgba(0, 0, 0, 0.25),
      inset 0 -1px 0 rgba(255, 255, 255, 0.35);
  }
  .window svg {
    display: block;
  }
  .scale {
    fill: none;
    stroke: var(--fg);
    stroke-width: 1.2;
  }
  .red {
    stroke: var(--accent);
  }
  path.red {
    fill: none;
    stroke-width: 3;
  }
  .minor {
    stroke: var(--fg);
    stroke-width: 0.8;
    opacity: 0.7;
  }
  .major {
    stroke: var(--fg);
    stroke-width: 1.4;
  }
  .lbl {
    font-family: "Share Tech Mono", monospace;
    font-size: 8px;
    fill: var(--fg);
  }
  text.red {
    fill: var(--accent);
  }
  .vu-mark {
    font-family: "Share Tech Mono", monospace;
    font-size: 15px;
    letter-spacing: 2px;
    fill: var(--accent);
  }
  .needle {
    stroke: var(--fg);
    stroke-width: 1.4;
    stroke-linecap: round;
    transform-origin: 110px 118px;
    animation: vu-wobble 1.2s ease-in-out infinite;
  }
  .live {
    position: absolute;
    top: 6px;
    left: 8px;
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--accent);
  }
  .strip {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-top: 6px;
    padding: 5px 10px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--fg) 12%, transparent);
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.3);
    line-height: 1;
  }
  .time {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    font-size: 20px;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
  }
  .time .sec {
    font-size: 13px;
    opacity: 0.75;
  }
  .date {
    font-size: 12px;
    letter-spacing: 1px;
    opacity: 0.8;
  }
  /* irregular program-material wobble */
  @keyframes vu-wobble {
    0% { transform: rotate(-32deg); }
    13% { transform: rotate(-6deg); }
    27% { transform: rotate(-22deg); }
    40% { transform: rotate(12deg); }
    55% { transform: rotate(-14deg); }
    68% { transform: rotate(24deg); }
    80% { transform: rotate(-2deg); }
    92% { transform: rotate(-26deg); }
    100% { transform: rotate(-32deg); }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".vu")) mountDigital(el);
</script>
