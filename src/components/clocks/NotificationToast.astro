---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="ntf"
  data-clock="notification-toast"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="card">
    <div class="icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3.5 2" />
      </svg>
    </div>
    <div class="body">
      <div class="meta">
        <span class="app">CLOCK</span>
        <span class="dot" data-with="date" hidden={!opts.date}>·</span>
        <span class="date" hidden={!opts.date}>--/-- ---</span>
        <span class="live" hidden={!opts.live}>LIVE</span>
      </div>
      <div class="time">
        <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
      </div>
    </div>
  </div>
</div>

<style>
  .ntf {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Zen Kaku Gothic New", system-ui, sans-serif;
    color: var(--fg);
  }
  .card {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 280px;
    box-sizing: border-box;
    padding: 12px 16px;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    border-radius: 18px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.08),
      0 10px 28px rgba(0, 0, 0, 0.16);
    animation: ntf-bob 3s ease-in-out infinite alternate;
  }
  @keyframes ntf-bob {
    to {
      transform: translateY(-4px);
    }
  }
  .icon {
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    background: var(--accent);
  }
  .icon svg {
    fill: none;
    stroke: var(--bg);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: color-mix(in srgb, var(--fg) 55%, transparent);
    line-height: 1.2;
  }
  .live {
    margin-left: auto;
    color: var(--accent);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 1px;
  }
  .time {
    display: flex;
    align-items: baseline;
    gap: 5px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .hm {
    font-size: 26px;
    font-weight: 700;
  }
  .sec {
    font-size: 14px;
    font-weight: 500;
    color: color-mix(in srgb, var(--fg) 60%, transparent);
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".ntf")) mountDigital(el);
</script>
