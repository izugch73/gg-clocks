---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="bios"
  data-clock="bios-setup"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="scr">
    <div class="menu" aria-hidden="true">
      <span class="on">Main</span><span>Advanced</span><span>Boot</span><span>Exit</span>
    </div>
    <div class="row sel">
      <span class="lbl">System Time</span>
      <span class="val"><span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>:--</span><span class="ampm"></span></span>
    </div>
    <div class="row date" hidden={!opts.date}>
      <span class="lbl">System Date</span>
      <span class="val dv">--/-- ---</span>
    </div>
    <div class="row live" hidden={!opts.live}>
      <span class="lbl">Stream Status</span>
      <span class="val">ON AIR</span>
    </div>
    <div class="foot" aria-hidden="true"><span>F10 Save &amp; Exit</span><span>ESC Exit</span></div>
  </div>
</div>

<style>
  .bios {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "IBM Plex Mono", monospace;
    color: var(--fg);
  }
  .scr {
    width: 300px;
    box-sizing: border-box;
    background: var(--bg);
    padding: 0 0 6px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 35%, transparent);
  }
  .menu {
    display: flex;
    gap: 14px;
    padding: 2px 10px;
    background: var(--fg);
    color: var(--bg);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }
  .menu .on {
    background: var(--bg);
    color: var(--fg);
    padding: 0 4px;
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin: 4px 8px 0;
    padding: 1px 4px;
    white-space: nowrap;
  }
  .row[hidden] {
    display: none;
  }
  .row.sel {
    margin-top: 7px;
    animation: bios-blink 2s steps(1, end) infinite;
  }
  .lbl {
    font-size: 11px;
    letter-spacing: 0.3px;
  }
  /* value text in near-white, brackets in accent */
  .val {
    color: color-mix(in srgb, var(--fg) 20%, white);
    font-size: 12px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .val::before {
    content: "[";
  }
  .val::after {
    content: "]";
  }
  .val::before,
  .val::after {
    color: var(--accent);
    font-weight: 700;
  }
  .sel .val {
    font-size: 18px;
  }
  .sel .sec,
  .sel .ampm {
    font-size: 13px;
    opacity: 0.9;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    margin: 6px 12px 0;
    padding-top: 3px;
    border-top: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
    font-size: 8px;
    letter-spacing: 0.5px;
    opacity: 0.75;
  }
  @keyframes bios-blink {
    0% {
      background: color-mix(in srgb, var(--fg) 22%, transparent);
    }
    50% {
      background: color-mix(in srgb, var(--fg) 8%, transparent);
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".bios")) {
    mountDigital(el, { renderSeconds: (s) => ":" + s, dateSelector: ".dv" });
  }
</script>
