---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="cb"
  data-clock="chalkboard"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="frame">
    <div class="board">
      <div class="smudge" aria-hidden="true"></div>
      <div class="top">
        <span class="date chalk" hidden={!opts.date}>--/--</span>
        <span class="live chalk" hidden={!opts.live}>● LIVE</span>
      </div>
      <div class="time chalk"><span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span></div>
      <div class="ledge" aria-hidden="true">
        <svg class="piece" viewBox="0 0 34 8" width="34" height="8">
          <rect class="stick" x="1" y="1" width="32" height="6" rx="2" opacity="0.92" />
          <rect x="1" y="5" width="32" height="2" rx="1" fill="rgba(0,0,0,0.18)" />
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .cb {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Caveat", cursive;
  }
  /* wooden frame with an inner bevel */
  .frame {
    width: 260px;
    box-sizing: border-box;
    border: 8px solid var(--accent);
    border-radius: 4px;
    background: var(--accent);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.18),
      inset 0 0 0 2px rgba(0, 0, 0, 0.18),
      0 6px 14px rgba(0, 0, 0, 0.3);
  }
  .board {
    position: relative;
    box-sizing: border-box;
    height: 114px;
    padding: 6px 12px 16px;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    box-shadow: inset 0 0 14px rgba(0, 0, 0, 0.45);
    overflow: hidden;
    color: var(--fg);
  }
  /* chalk dust smudges: layered soft radial-gradients */
  .smudge {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(ellipse 120px 50px at 30% 60%, rgba(255, 255, 255, 0.07), transparent 70%),
      radial-gradient(ellipse 90px 70px at 75% 30%, rgba(255, 255, 255, 0.05), transparent 70%),
      radial-gradient(ellipse 160px 40px at 60% 85%, rgba(255, 255, 255, 0.06), transparent 70%),
      repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.02) 0 2px, transparent 2px 7px);
  }
  .chalk {
    opacity: 0.92;
    text-shadow:
      0 0 1px var(--fg),
      0 0 2px color-mix(in srgb, var(--fg) 45%, transparent);
  }
  .top {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 18px;
    font-weight: 400;
    line-height: 1;
    min-height: 0;
  }
  .live {
    margin-left: auto;
    font-size: 16px;
  }
  .time {
    position: relative;
    text-align: center;
    font-size: 54px;
    font-weight: 700;
    line-height: 1;
    margin: auto 0; /* stays vertically centred whether or not the top row has content */
    transform: rotate(-1.5deg);
    font-variant-numeric: tabular-nums;
  }
  .sec {
    font-size: 26px;
    margin-left: 6px;
    font-weight: 400;
  }
  .ledge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 8px;
    background: color-mix(in srgb, var(--accent) 85%, black);
    box-shadow: 0 -1px 0 rgba(255, 255, 255, 0.15);
  }
  .piece {
    position: absolute;
    right: 18px;
    bottom: 3px;
    transform: rotate(-4deg);
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.4));
  }
  .stick {
    fill: var(--fg);
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".cb")) {
    mountDigital(el, {
      renderDate: (p, lang) => (lang === "en" ? `Today: ${p.month}/${p.day}` : `今日: ${p.month}/${p.day}`),
    });
  }
</script>
