---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="tr"
  data-clock="target-reticle"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="box">
    <svg viewBox="0 0 180 180" width="180" height="180" aria-hidden="true">
      <g class="rings">
        <!-- corner brackets -->
        <path d="M6 30V6h24M150 6h24v24M174 150v24h-24M30 174H6v-24" stroke-width="2" />
        <!-- outer dashed ring (rotates) -->
        <circle class="spin" cx="90" cy="90" r="78" stroke-width="1.5" stroke-dasharray="14 8" />
        <!-- inner solid ring + cardinal ticks -->
        <circle cx="90" cy="90" r="62" stroke-width="1.5" />
        <path d="M90 22v12M90 146v12M22 90h12M146 90h12" stroke-width="2" />
        <path d="M86 90h8M90 86v8" stroke-width="1" opacity="0.6" />
      </g>
    </svg>
    <span class="lock" aria-hidden="true">LOCK</span>
    <div class="readout">
      <div class="live" hidden={!opts.live}>LIVE</div>
      <div class="hm">--:--</div>
      <div class="sub">
        <span class="sec" hidden={!opts.seconds}>--</span><span class="ampm"></span>
      </div>
      <div class="date" hidden={!opts.date}>--/-- ---</div>
    </div>
  </div>
</div>

<style>
  .tr {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Audiowide", sans-serif;
    color: var(--fg);
  }
  .box {
    position: relative;
    width: 180px;
    height: 180px;
    background: var(--bg);
    border-radius: 50%;
  }
  svg {
    position: absolute;
    inset: 0;
    display: block;
  }
  .rings {
    fill: none;
    stroke: var(--accent);
    filter: drop-shadow(0 0 3px var(--accent));
  }
  .spin {
    transform-origin: 90px 90px;
    animation: tr-spin 20s linear infinite;
  }
  .lock {
    position: absolute;
    top: 8px;
    right: 34px;
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--accent);
    text-shadow: 0 0 6px var(--accent);
    animation: tr-blink 1.2s steps(2, end) infinite;
  }
  .readout {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1;
    text-shadow: 0 0 8px color-mix(in srgb, var(--fg) 50%, transparent);
  }
  .live {
    font-size: 9px;
    letter-spacing: 3px;
    color: var(--accent);
    margin-bottom: 5px;
  }
  .hm {
    font-size: 26px;
    letter-spacing: 1px;
    white-space: nowrap;
  }
  .sub {
    display: flex;
    gap: 6px;
    justify-content: center;
    font-size: 13px;
    opacity: 0.85;
  }
  .sub > * {
    margin-top: 5px;
  }
  .ampm:empty {
    display: none;
  }
  .date {
    margin-top: 6px;
    font-size: 10px;
    letter-spacing: 1px;
    opacity: 0.8;
  }
  @keyframes tr-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes tr-blink {
    50% {
      opacity: 0.15;
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".tr")) mountDigital(el);
</script>
