---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="pc"
  data-clock="power-core"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="core">
    <div class="track" aria-hidden="true"></div>
    <svg class="seg" viewBox="0 0 240 240" aria-hidden="true">
      <circle cx="120" cy="120" r="88" />
    </svg>
    <svg class="orbit" viewBox="0 0 240 240" aria-hidden="true">
      <circle cx="120" cy="120" r="76" />
    </svg>
    <div class="disc">
      <span class="hm">--:--</span>
      <span class="ampm"></span>
      <span class="sec" hidden={!opts.seconds}>--</span>
      <span class="date" hidden={!opts.date}>--/-- ---</span>
      <span class="live" hidden={!opts.live}><span class="lamp"></span>LIVE</span>
    </div>
  </div>
</div>

<style>
  .pc {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Audiowide", sans-serif;
    color: var(--fg);
  }
  .core {
    position: relative;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--bg) 70%, black) 0 30%, var(--bg) 60%, color-mix(in srgb, var(--bg) 85%, var(--accent)) 100%);
    box-shadow: 0 0 30px color-mix(in srgb, var(--accent) 35%, transparent), inset 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  [hidden] {
    display: none !important;
  }
  /* charge ring: --p (fraction of the day elapsed) is set by the script each tick */
  .track {
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    background: conic-gradient(var(--accent) calc(var(--p, 0) * 1turn), color-mix(in srgb, var(--accent) 15%, transparent) 0);
    -webkit-mask: radial-gradient(circle, transparent calc(50% - 13px), #000 calc(50% - 12px));
    mask: radial-gradient(circle, transparent calc(50% - 13px), #000 calc(50% - 12px));
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--accent) 60%, transparent));
  }
  .seg,
  .orbit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
  }
  .seg circle {
    stroke: var(--accent);
    stroke-width: 5;
    stroke-dasharray: 34 12;
    opacity: 0.9;
  }
  .seg {
    animation: pc-spin 24s linear infinite;
  }
  .orbit circle {
    stroke: var(--fg);
    stroke-width: 1;
    stroke-dasharray: 2 6;
    opacity: 0.6;
  }
  .orbit {
    animation: pc-spin 40s linear infinite reverse;
  }
  @keyframes pc-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .disc {
    position: absolute;
    inset: 50px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--bg) 60%, black), color-mix(in srgb, var(--bg) 85%, black));
    box-shadow: 0 0 18px color-mix(in srgb, var(--accent) 45%, transparent), inset 0 0 0 2px color-mix(in srgb, var(--accent) 50%, transparent);
    line-height: 1;
    text-align: center;
  }
  .hm {
    font-size: 30px;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 70%, transparent);
    white-space: nowrap;
  }
  .ampm {
    font-size: 10px;
    letter-spacing: 2px;
    opacity: 0.8;
  }
  .ampm:empty {
    display: none;
  }
  .sec {
    font-size: 14px;
    color: var(--accent);
    letter-spacing: 2px;
  }
  .date {
    font-size: 10px;
    letter-spacing: 1px;
    opacity: 0.8;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 2px;
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--accent);
  }
  .lamp {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
    animation: pc-lamp 2s steps(1, end) infinite;
  }
  @keyframes pc-lamp {
    50% {
      opacity: 0.35;
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".pc")) {
    mountDigital(el, {
      onTick: (p) => {
        const frac = (p.hour * 3600 + p.minute * 60 + p.second) / 86400;
        el.style.setProperty("--p", frac.toFixed(5));
      },
    });
  }
</script>
