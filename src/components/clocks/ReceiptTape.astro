---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="rct"
  data-clock="receipt-tape"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="paper">
    <div class="head">* RECEIPT *</div>
    <div class="rule"></div>
    <div class="row total">
      <span class="k">TIME</span>
      <span class="v"><span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>:--</span></span>
    </div>
    <div class="row date" hidden={!opts.date}>
      <span class="k">DATE</span>
      <span class="v dv">--/-- ---</span>
    </div>
    <div class="row live" hidden={!opts.live}>
      <span class="k">STATUS</span>
      <span class="v">ON AIR</span>
    </div>
    <div class="rule"></div>
    <div class="barcode" aria-hidden="true"></div>
  </div>
</div>

<style>
  .rct {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Space Mono", "Menlo", monospace;
    color: var(--fg);
  }
  .paper {
    width: 190px;
    box-sizing: border-box;
    padding: 12px 14px 20px;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.08), transparent 10%, transparent 90%, rgba(0, 0, 0, 0.08)),
      var(--bg);
    /* zigzag bottom edge: solid body + a row of 12x6px downward teeth */
    -webkit-mask:
      linear-gradient(#000 0 0) top / 100% calc(100% - 6px) no-repeat,
      conic-gradient(from -45deg at 50% 100%, #000 90deg, transparent 0) bottom / 12px 6px repeat-x;
    mask:
      linear-gradient(#000 0 0) top / 100% calc(100% - 6px) no-repeat,
      conic-gradient(from -45deg at 50% 100%, #000 90deg, transparent 0) bottom / 12px 6px repeat-x;
    font-size: 11px;
    line-height: 1.3;
  }
  .head {
    text-align: center;
    letter-spacing: 2px;
    font-weight: 700;
  }
  .rule {
    height: 0;
    margin: 6px 0;
    border-top: 1px dashed color-mix(in srgb, var(--fg) 45%, transparent);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin-top: 3px;
  }
  .k {
    letter-spacing: 1px;
    color: color-mix(in srgb, var(--fg) 70%, transparent);
  }
  .v {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .total {
    margin-top: 2px;
  }
  .total .v {
    color: var(--accent);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.1;
  }
  .total .sec {
    font-size: 15px;
  }
  .barcode {
    height: 24px;
    margin-top: 2px;
    opacity: 0.55;
    background: repeating-linear-gradient(
      90deg,
      var(--fg) 0 2px,
      transparent 2px 4px,
      var(--fg) 4px 5px,
      transparent 5px 8px,
      var(--fg) 8px 11px,
      transparent 11px 13px,
      var(--fg) 13px 14px,
      transparent 14px 17px
    );
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".rct"))
    mountDigital(el, { renderSeconds: (s) => ":" + s, dateSelector: ".date .dv" });
</script>
