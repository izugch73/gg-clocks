---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
const hasSub = opts.date || opts.live;
---

<div
  class="hp"
  data-clock="hp-bar"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="panel">
    <div class="row">
      <span class="label">HP</span>
      <span class="track" aria-hidden="true"><span class="fill"></span></span>
      <span class="time">
        <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>:--</span>
      </span>
    </div>
    <div class="sub" hidden={!hasSub}>
      <span class="date" hidden={!opts.date}>--/-- ---</span>
      <span class="live" hidden={!opts.live}>● LIVE</span>
    </div>
  </div>
</div>

<style>
  .hp {
    --hp: 1;
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Press Start 2P", monospace;
    color: var(--fg);
  }
  .panel {
    width: 300px;
    padding: 10px 12px;
    background: var(--bg);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .label {
    font-size: 12px;
    line-height: 1;
    color: var(--accent);
    flex: none;
  }
  .track {
    flex: 1;
    height: 14px;
    border-radius: 7px;
    background: color-mix(in srgb, var(--fg) 14%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 25%, transparent);
    overflow: hidden;
    padding: 2px;
  }
  /* --hp is the fraction of the day remaining (set every second in onTick).
     Hue rotates the accent green -> yellow -> red as it drains. */
  .fill {
    display: block;
    position: relative;
    height: 100%;
    width: calc(var(--hp, 1) * 100%);
    min-width: 6px;
    border-radius: 5px;
    background: var(--accent);
    filter: hue-rotate(calc((1 - var(--hp, 1)) * -120deg));
    transition: width 1s linear;
  }
  .fill::after {
    content: "";
    position: absolute;
    left: 2px;
    right: 2px;
    top: 1px;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.45);
  }
  .time {
    flex: none;
    font-size: 12px;
    line-height: 1;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .sec {
    font-size: 9px;
    opacity: 0.75;
  }
  .sub {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 8px;
    line-height: 1;
    letter-spacing: 1px;
    color: color-mix(in srgb, var(--fg) 70%, transparent);
  }
  .live {
    margin-left: auto;
    color: var(--accent);
    animation: hp-blink 1.6s steps(2, end) infinite;
  }
  @keyframes hp-blink {
    50% {
      opacity: 0.3;
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".hp")) {
    const sub = el.querySelector<HTMLElement>(".sub");
    mountDigital(el, {
      renderSeconds: (s) => ":" + s,
      onTick: (p) => {
        const elapsed = (p.hour * 3600 + p.minute * 60 + p.second) / 86400;
        el.style.setProperty("--hp", (1 - elapsed).toFixed(5));
        // The sub row wraps both date and LIVE; collapse it (no gap) when neither
        // is shown, including after the embed page's URL overrides.
        if (sub) sub.toggleAttribute("hidden", el.dataset.date !== "1" && el.dataset.live !== "1");
      },
    });
  }
</script>
