---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="em"
  data-clock="ema-plaque"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <!-- Red-and-white twisted cord: a loop above the board, passing through the hole. -->
  <svg class="cord" viewBox="0 0 200 40" width="200" height="40" aria-hidden="true">
    <path class="cord-red" d="M100 40 V22 M100 22 C100 4 72 4 86 14 C96 22 104 22 114 14 C128 4 100 4 100 22" />
    <path class="cord-white" d="M100 40 V22 M100 22 C100 4 72 4 86 14 C96 22 104 22 114 14 C128 4 100 4 100 22" />
  </svg>
  <div class="board">
    <div class="face">
      <span class="hole" aria-hidden="true"></span>
      <svg class="torii" viewBox="0 0 24 22" width="24" height="22" aria-hidden="true">
        <path d="M1 3 Q12 6 23 3 L22 7 H2 Z" />
        <rect x="3" y="9" width="18" height="2" />
        <rect x="5" y="7" width="3" height="15" />
        <rect x="16" y="7" width="3" height="15" />
        <rect x="11" y="7" width="2" height="4" />
      </svg>
      <span class="live" hidden={!opts.live}>LIVE</span>
      <div class="main">
        <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span><span class="ampm"></span>
      </div>
      <span class="date" hidden={!opts.date}>--/-- ---</span>
    </div>
  </div>
</div>

<style>
  .em {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 200px;
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Yusei Magic", sans-serif;
    color: var(--fg);
  }
  .cord {
    display: block;
    margin-bottom: -22px; /* reaches down into the hole */
    position: relative;
    z-index: 1;
  }
  .cord-red {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4;
    stroke-linecap: round;
  }
  .cord-white {
    fill: none;
    stroke: white;
    stroke-width: 4;
    stroke-linecap: butt;
    stroke-dasharray: 4 6;
    opacity: 0.85;
  }
  /* Pentagon board: a darker rim with the lighter wood face inset by 3px. */
  .board {
    position: relative;
    width: 200px;
    height: 128px;
    clip-path: polygon(50% 0, 100% 24%, 100% 100%, 0 100%, 0 24%);
    background: color-mix(in srgb, var(--fg) 35%, var(--bg));
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.2));
  }
  .face {
    position: absolute;
    inset: 3px;
    clip-path: polygon(50% 0, 100% 24%, 100% 100%, 0 100%, 0 24%);
    background-color: var(--bg);
    background-image: repeating-linear-gradient(
      97deg,
      transparent 0 6px,
      color-mix(in srgb, var(--fg) 7%, transparent) 6px 8px,
      transparent 8px 15px
    );
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 30px 34px 8px 20px;
  }
  .hole {
    position: absolute;
    top: 14px;
    left: 50%;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--fg) 55%, var(--bg));
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.5);
  }
  .torii {
    position: absolute;
    left: 12px;
    top: 36px;
    fill: var(--accent);
  }
  .live {
    position: absolute;
    right: 12px;
    top: 36px;
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--accent);
  }
  .main {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 36px;
    line-height: 1.1;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sec,
  .ampm {
    font-size: 16px;
    opacity: 0.8;
  }
  .date {
    position: absolute;
    right: 10px;
    top: 56px;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-size: 12px;
    letter-spacing: 1px;
    opacity: 0.85;
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".em")) mountDigital(el);
</script>
