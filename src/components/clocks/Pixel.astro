---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="px"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="box">
    <div class="row" data-with="live" hidden={!opts.live}>
      <span class="live" hidden={!opts.live}>● LIVE</span>
    </div>
    <div class="time"><span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span></div>
    <div class="date" hidden={!opts.date}>--/-- ---</div>
  </div>
</div>

<style>
  .px {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    padding: 6px;
  }
  .box {
    background: var(--bg, transparent);
    color: var(--fg);
    font-family: "Press Start 2P", "Courier New", monospace;
    padding: 14px 18px 16px;
    border: 4px solid var(--fg);
    box-shadow:
      4px 4px 0 var(--accent),
      8px 8px 0 var(--fg);
    text-align: center;
    image-rendering: pixelated;
  }
  .row {
    margin-bottom: 6px;
  }
  .live {
    display: inline-block;
    padding: 4px 6px;
    font-size: 9px;
    background: var(--accent);
    color: #fff;
    letter-spacing: 2px;
  }
  .time {
    font-size: 26px;
    letter-spacing: 3px;
    line-height: 1.1;
    text-shadow: 3px 3px 0 var(--accent);
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .sec {
    font-size: 14px;
    text-shadow: 2px 2px 0 var(--accent);
  }
  .date {
    margin-top: 10px;
    font-size: 10px;
    letter-spacing: 3px;
    opacity: 0.95;
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".px")) mountDigital(el);
</script>
