---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
// SSR placeholder; the script rebuilds the notes from the real time.
const placeholder = ["-", "-", ":", "-", "-"];
---

<div
  class="sm"
  data-clock="sheet-music"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="paper">
    <!-- .hm/.sec stay in the DOM for the runtime; the notes mirror them -->
    <div class="src" aria-hidden="true">
      <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
    </div>
    <div class="tempo">
      <span class="date" hidden={!opts.date}>
        <svg class="qn" viewBox="0 0 10 16" width="8" height="13" aria-hidden="true">
          <ellipse cx="4" cy="13" rx="3.6" ry="2.4" transform="rotate(-20 4 13)"></ellipse>
          <rect x="6.6" y="1" width="1.2" height="12"></rect>
        </svg>
        <span class="dv">= --/-- ---</span>
      </span>
      <span class="live" hidden={!opts.live}>LIVE</span>
    </div>
    <div class="staff">
      <svg class="clef" viewBox="0 0 32 72" width="32" height="72" aria-hidden="true">
        <path
          d="M 8 63 c -2 6 7 8 7 1 L 19 7 C 19 1 25 1 24 8 C 23 16 12 22 10 33 C 8 44 17 49 23 43 C 29 37 24 29 17 31 C 12 33 12 38 15 40"
        ></path>
      </svg>
      <span class="notes">{placeholder.map((c) => (c === ":" ? <span class="colon"><i></i><i></i></span> : <span class="d">{c}</span>))}</span>
      <svg class="eighth" viewBox="0 0 14 22" width="14" height="22" aria-hidden="true">
        <ellipse cx="4.5" cy="18" rx="4.2" ry="2.8" transform="rotate(-20 4.5 18)"></ellipse>
        <rect x="7.6" y="2" width="1.3" height="16"></rect>
        <path d="M8.9 2 C 11 6 13.5 7 12 13 C 12.5 9 10 7.5 8.9 6 Z"></path>
      </svg>
    </div>
  </div>
</div>

<style>
  .sm {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Playfair Display", serif;
    color: var(--fg);
  }
  .src {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .paper {
    position: relative;
    width: 280px;
    padding: 8px 12px 20px;
    background: var(--bg);
    border-radius: 2px;
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--fg) 10%, transparent),
      0 6px 16px rgba(0, 0, 0, 0.14);
  }
  .tempo {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 12px;
    font-style: italic;
    line-height: 16px;
    padding-left: 6px;
  }
  .date {
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
  }
  .qn {
    fill: var(--fg);
    align-self: center;
  }
  .live {
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--accent);
  }
  /* five staff lines 9px apart; the clef hangs over them */
  .staff {
    position: relative;
    height: 37px;
    margin-top: 16px;
    background: repeating-linear-gradient(180deg, var(--fg) 0 1px, transparent 1px 9px);
  }
  .clef {
    position: absolute;
    left: 2px;
    top: -14px;
    overflow: visible;
  }
  .clef path {
    fill: none;
    stroke: var(--fg);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .notes {
    position: absolute;
    left: 42px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 3px;
  }
  /* digits sit at staggered heights like notes; a paper halo keeps them legible over the lines */
  .d {
    display: inline-block;
    font-size: 30px;
    font-weight: 700;
    line-height: 1;
    text-shadow:
      0 0 3px var(--bg),
      0 0 3px var(--bg),
      0 0 4px var(--bg),
      0 0 5px var(--bg);
  }
  .d:nth-child(6n + 1) { transform: translateY(-7px); }
  .d:nth-child(6n + 2) { transform: translateY(4px); }
  .d:nth-child(6n + 4) { transform: translateY(-3px); }
  .d:nth-child(6n + 5) { transform: translateY(7px); }
  .d:nth-child(6n) { transform: translateY(-5px); }
  .d.s {
    font-size: 20px;
  }
  .a {
    font-size: 13px;
    font-style: italic;
    margin-left: 4px;
    text-shadow: 0 0 3px var(--bg), 0 0 3px var(--bg);
  }
  .colon {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    margin: 0 3px;
  }
  .colon i {
    width: 10px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    transform: rotate(-20deg);
  }
  .eighth {
    position: absolute;
    right: 4px;
    top: -18px;
    fill: var(--accent);
    animation: sm-bounce 1s ease-in-out infinite;
  }
  @keyframes sm-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }
</style>

<script>
  import { mountDigital, formatHour, formatDate, pad2 } from "../../lib/clock-runtime";

  for (const el of document.querySelectorAll<HTMLElement>(".sm")) {
    const notes = el.querySelector<HTMLElement>(".notes")!;
    mountDigital(el, {
      dateSelector: ".date .dv",
      renderDate: (p, lang) => "= " + formatDate(p, lang),
      onTick: (p, { format }) => {
        const { hour, suffix } = formatHour(p.hour, format);
        const sec = el.dataset.seconds === "1" ? ":" + pad2(p.second) : "";
        const text = `${hour}:${pad2(p.minute)}${sec}${suffix.trim()}`;
        const secStart = sec ? hour.length + 3 : -1;
        const list = [...text].map((c, i) => ({
          c,
          cls: c === ":" ? "colon" : /[A-Z]/.test(c) ? "a" : secStart >= 0 && i >= secStart && i < secStart + 3 ? "d s" : "d",
        }));
        if (notes.childElementCount !== list.length) {
          notes.replaceChildren(
            ...list.map(({ c, cls }) => {
              const s = document.createElement("span");
              s.className = cls;
              if (cls === "colon") s.append(document.createElement("i"), document.createElement("i"));
              else s.textContent = c;
              return s;
            }),
          );
          return;
        }
        list.forEach(({ c, cls }, i) => {
          const s = notes.children[i];
          if (cls !== "colon" && s.textContent !== c) s.textContent = c;
        });
      },
    });
  }
</script>
