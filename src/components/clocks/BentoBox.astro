---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
// Lettuce strip: zig-zag top edge as a clip-path polygon.
const teeth = 8;
const zig = Array.from({ length: teeth * 2 + 1 }, (_, i) => `${(i / (teeth * 2)) * 100}% ${i % 2 ? 0 : 18}%`);
const lettuceClip = `polygon(${zig.join(", ")}, 100% 100%, 0 100%)`;
---

<div
  class="bb"
  data-clock="bento-box"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="box">
    <div class="sheen" aria-hidden="true"></div>
    <span class="live" hidden={!opts.live}>LIVE</span>
    <div class="inner">
      <div class="cell rice">
        <span class="ume" aria-hidden="true"></span>
        <span class="hm">--:--</span>
      </div>
      <div class="col">
        <div class="cell tamago" data-with="date" hidden={!opts.date}>
          <span class="date">--/-- ---</span>
        </div>
        <div class="cell lettuce" data-with="sec" hidden={!opts.seconds} style={`clip-path:${lettuceClip}`}>
          <span class="sec">--</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .bb {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Dela Gothic One", "Kosugi Maru", sans-serif;
  }
  .box {
    position: relative;
    width: 300px;
    height: 140px;
    padding: 10px;
    border-radius: 12px;
    background: var(--bg);
    border: 3px solid var(--accent);
    box-shadow:
      inset 0 0 0 2px color-mix(in srgb, var(--bg) 70%, #000),
      0 8px 18px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }
  .sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.04) 35%, transparent 60%);
    z-index: 2;
  }
  .live {
    position: absolute;
    top: 0;
    right: 16px;
    z-index: 3;
    padding: 1px 8px 3px;
    border-radius: 0 0 6px 6px;
    background: var(--accent);
    color: #fff;
    font-size: 9px;
    letter-spacing: 2px;
  }
  .inner {
    position: relative;
    height: 100%;
    display: flex;
    padding: 4px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--fg) 55%, var(--bg)); /* partitions */
  }
  .cell {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.25);
  }
  .rice {
    position: relative;
    flex: 1;
    min-width: 0;
    background:
      radial-gradient(circle at 30% 40%, rgba(230, 215, 180, 0.9) 0 1.2px, transparent 2px) 0 0 / 9px 9px,
      radial-gradient(circle at 70% 70%, rgba(220, 205, 170, 0.8) 0 1px, transparent 1.8px) 3px 4px / 11px 11px,
      #fff;
  }
  .ume {
    position: absolute;
    top: 8px;
    right: 10px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.5), transparent 40%), var(--accent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }
  .hm {
    font-size: 34px;
    line-height: 1;
    color: var(--fg);
    white-space: nowrap;
  }
  [data-format="12"] .hm {
    font-size: 24px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .col .cell {
    flex: 1;
    width: 96px;
    margin-left: 4px;
  }
  .tamago {
    background: repeating-linear-gradient(
      180deg,
      #f7cf4f 0 7px,
      #f3b92e 7px 9px,
      #fbe08a 9px 11px,
      #f7cf4f 11px 14px
    );
  }
  .date {
    font-size: 13px;
    color: var(--fg);
    white-space: nowrap;
    letter-spacing: 0.5px;
  }
  .lettuce {
    background: linear-gradient(180deg, #7fc25a, #4e9a3c);
    box-shadow: none;
  }
  .sec {
    font-size: 22px;
    line-height: 1;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    padding-top: 4px;
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".bb")) mountDigital(el);
</script>
