---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="br"
  data-clock="bracket"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="wrap">
    <div class="line">
      <span class="bracket left">[</span><span class="live" hidden={!opts.live}> LIVE </span><span
        class="time"><span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>:--</span></span><span
        class="bracket right">]</span>
    </div>
    <div class="date" hidden={!opts.date}>// --/-- ---</div>
  </div>
</div>

<style>
  .br {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Share Tech Mono", "Menlo", monospace;
    color: var(--fg);
    padding: 6px 8px;
    background: var(--bg);
  }
  .line {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    font-size: 30px;
    line-height: 1;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
  }
  .bracket {
    color: var(--accent);
    font-weight: 700;
  }
  .live {
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--accent);
    font-weight: 700;
    align-self: center;
    padding: 0 2px;
  }
  .time .sec {
    font-size: 18px;
    opacity: 0.65;
  }
  .date {
    margin-top: 4px;
    font-size: 12px;
    letter-spacing: 2px;
    opacity: 0.7;
    padding-left: 4px;
  }
</style>

<script>
  import { mountDigital, formatDate } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".br")) {
    mountDigital(el, {
      renderSeconds: (s) => ":" + s,
      renderDate: (p, lang) => "// " + formatDate(p, lang),
    });
  }
</script>
