---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="tsp"
  data-clock="toast-pop"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="bread">
    <span class="live" hidden={!opts.live}>LIVE</span>
    <div class="time">
      <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
    </div>
    <span class="date" hidden={!opts.date}>--/-- ---</span>
  </div>
  <div class="toaster">
    <span class="slot" aria-hidden="true"></span>
    <span class="lever" aria-hidden="true"></span>
    <span class="dial" aria-hidden="true"></span>
    <span class="foot l" aria-hidden="true"></span>
    <span class="foot r" aria-hidden="true"></span>
  </div>
</div>

<style>
  .tsp {
    /* bread colours are derived from --bg (tan): darker crust and brown text */
    --crust: color-mix(in srgb, var(--bg) 55%, #000);
    --brown: color-mix(in srgb, var(--bg) 25%, #000);
    position: relative;
    width: 200px;
    height: 170px;
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Hachi Maru Pop", system-ui, sans-serif;
  }
  .bread {
    position: absolute;
    left: 38px;
    top: 10px;
    width: 124px;
    height: 110px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6px 6px 36px; /* lower part sits inside the toaster */
    gap: 1px;
    background: var(--bg);
    border: 4px solid var(--crust);
    border-radius: 44px 44px 10px 10px;
    color: var(--brown);
    line-height: 1;
    z-index: 0;
  }
  .bread.pop {
    animation: tsp-pop 0.5s ease-out;
  }
  @keyframes tsp-pop {
    40% {
      transform: translateY(-10px);
    }
  }
  .time {
    display: flex;
    align-items: baseline;
    gap: 4px;
    font-variant-numeric: tabular-nums;
  }
  .hm {
    font-size: 32px;
  }
  .sec {
    font-size: 15px;
    opacity: 0.8;
  }
  .date {
    font-size: 12px;
    margin-top: 2px;
    opacity: 0.85;
  }
  .live {
    font-size: 10px;
    letter-spacing: 1.5px;
    color: var(--accent);
    margin-bottom: 2px;
  }
  .toaster {
    position: absolute;
    left: 0;
    bottom: 8px;
    width: 200px;
    height: 84px;
    border-radius: 20px 20px 12px 12px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--fg) 70%, #fff) 0%,
      var(--fg) 45%,
      color-mix(in srgb, var(--fg) 75%, #000) 100%
    );
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, 0.5),
      0 6px 14px rgba(0, 0, 0, 0.22);
    z-index: 1;
  }
  .slot {
    position: absolute;
    left: 30px;
    top: 7px;
    width: 140px;
    height: 10px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--fg) 30%, #000);
    box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.6);
  }
  .lever {
    position: absolute;
    right: -8px;
    top: 22px;
    width: 14px;
    height: 22px;
    border-radius: 4px;
    background: var(--accent);
    box-shadow: 0 2px 0 color-mix(in srgb, var(--accent) 60%, #000);
  }
  .dial {
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--fg) 60%, #000);
    box-shadow: inset 0 0 0 3px color-mix(in srgb, var(--fg) 85%, #fff);
  }
  .foot {
    position: absolute;
    bottom: -8px;
    width: 22px;
    height: 10px;
    border-radius: 0 0 6px 6px;
    background: color-mix(in srgb, var(--fg) 50%, #000);
  }
  .foot.l {
    left: 24px;
  }
  .foot.r {
    right: 24px;
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".tsp")) {
    const bread = el.querySelector<HTMLElement>(".bread");
    mountDigital(el, {
      onTick: (p) => {
        // The slice pops once at the top of every minute.
        if (p.second !== 0 || !bread) return;
        bread.classList.remove("pop");
        void bread.offsetWidth; // restart the animation
        bread.classList.add("pop");
      },
    });
  }
</script>
