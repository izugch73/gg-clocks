---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
// Sixteen bars, each with its own bounce period (0.6–1.4s) and phase.
const bars = Array.from({ length: 16 }, (_, i) => ({
  dur: (0.6 + ((i * 7) % 9) * 0.1).toFixed(2),
  delay: (-((i * 13) % 11) * 0.13).toFixed(2),
  peak: (0.45 + ((i * 5) % 7) * 0.08).toFixed(2),
}));
---

<div
  class="eq"
  data-clock="equalizer-bars"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="panel">
    <div class="bars" aria-hidden="true">
      {bars.map((b) => <span class="bar" style={`--dur:${b.dur}s;--delay:${b.delay}s;--peak:${b.peak}`} />)}
    </div>
    <div class="content">
      <div class="live" hidden={!opts.live}><span class="dot" aria-hidden="true"></span>LIVE</div>
      <div class="time"><span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span></div>
      <div class="date" hidden={!opts.date}>--/-- ---</div>
    </div>
  </div>
</div>

<style>
  .eq {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Audiowide", "Orbitron", sans-serif;
  }
  .panel {
    position: relative;
    width: 290px;
    height: 110px;
    box-sizing: border-box;
    border-radius: 12px;
    background: var(--bg);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent),
      inset 0 0 24px color-mix(in srgb, var(--accent) 18%, transparent),
      0 8px 24px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg);
  }
  .bars {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 8px;
    height: 84px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    pointer-events: none;
  }
  .bar {
    width: 8px;
    height: 100%;
    border-radius: 3px 3px 1px 1px;
    background: linear-gradient(180deg, var(--fg) 0%, var(--accent) 45%, color-mix(in srgb, var(--accent) 60%, transparent) 100%);
    opacity: 0.55;
    transform: scaleY(0.2);
    transform-origin: bottom;
    animation: eq-bounce var(--dur) ease-in-out var(--delay) infinite alternate;
  }
  .content {
    position: relative;
    text-align: center;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 4px;
    padding: 2px 9px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.45);
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--accent);
  }
  .live .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
  }
  .time {
    font-size: 40px;
    line-height: 1;
    letter-spacing: 2px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-shadow:
      0 0 3px rgba(0, 0, 0, 0.95),
      0 2px 6px rgba(0, 0, 0, 0.9),
      0 0 18px rgba(0, 0, 0, 0.8);
  }
  .sec {
    font-size: 20px;
    margin-left: 6px;
    opacity: 0.85;
  }
  .date {
    margin-top: 6px;
    font-size: 12px;
    letter-spacing: 3px;
    opacity: 0.9;
    text-shadow:
      0 0 3px rgba(0, 0, 0, 0.95),
      0 1px 4px rgba(0, 0, 0, 0.9);
  }
  @keyframes eq-bounce {
    from {
      transform: scaleY(0.12);
    }
    to {
      transform: scaleY(var(--peak));
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".eq")) mountDigital(el);
</script>
