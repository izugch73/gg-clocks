---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="vtt"
  data-clock="vertical-tate"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="strip" lang="ja">
    <div class="col time">
      <span class="ampm"></span>
      <span class="hm">--:--</span>
      <span class="sec" hidden={!opts.seconds}>--</span>
    </div>
    <div class="col kanji" aria-hidden="true">
      <span class="live" hidden={!opts.live}>生放送</span>
      <span class="kj">　</span>
    </div>
    <span class="date col" hidden={!opts.date}>--/-- ---</span>
  </div>
</div>

<style>
  .vtt {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Noto Serif JP", serif;
    color: var(--fg);
    text-shadow: 0 0 3px rgba(255, 255, 255, 0.55);
  }
  .strip {
    display: flex;
    flex-direction: row-reverse; /* first column at the right, like tategaki */
    align-items: flex-start;
    gap: 6px;
    height: 232px;
    padding: 6px 6px 6px 4px;
    background: var(--bg);
    border-right: 1px solid color-mix(in srgb, var(--fg) 60%, transparent);
  }
  .col {
    writing-mode: vertical-rl;
    text-orientation: upright;
    line-height: 1.05;
    white-space: nowrap; /* never wrap into a second column */
    font-variant-numeric: tabular-nums;
  }
  .time {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .ampm {
    font-size: 11px;
    letter-spacing: 0.1em;
    font-weight: 400;
  }
  .sec {
    font-size: 14px;
    font-weight: 400;
    opacity: 0.7;
    margin-top: 4px;
  }
  .kanji {
    font-size: 14px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.1em;
    margin-top: 4px;
  }
  .live {
    font-size: 11px;
    margin-bottom: 8px;
    padding: 2px 1px;
    border: 1px solid var(--accent);
  }
  .date {
    font-size: 12px;
    font-weight: 400;
    opacity: 0.8;
    letter-spacing: 0.1em;
    margin-top: 4px;
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";

  const K = "〇一二三四五六七八九";
  // 0 -> 零, 5 -> 五, 10 -> 十, 14 -> 十四, 32 -> 三十二
  function kanjiNum(n: number): string {
    if (n === 0) return "零";
    const tens = Math.floor(n / 10);
    const ones = n % 10;
    return (tens > 1 ? K[tens] : "") + (tens >= 1 ? "十" : "") + (ones ? K[ones] : "");
  }

  for (const el of document.querySelectorAll<HTMLElement>(".vtt")) {
    const kj = el.querySelector<HTMLElement>(".kj");
    mountDigital(el, {
      onTick: (p, { format }) => {
        if (!kj) return;
        const h = format === "12" ? (p.hour % 12 === 0 ? 12 : p.hour % 12) : p.hour;
        const prefix = format === "12" ? (p.hour >= 12 ? "午後" : "午前") : "";
        kj.textContent = `${prefix}${kanjiNum(h)}時${kanjiNum(p.minute)}分`;
      },
    });
  }
</script>
