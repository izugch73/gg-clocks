---
/**
 * Renders the clock component for a slug.
 *
 * Components are discovered automatically: `src/components/clocks/<Name>.astro`
 * serves the slug whose PascalCase form is `<Name>` (e.g. "led-dot-matrix" →
 * LedDotMatrix.astro). Adding a clock = add the .astro file + its entry in
 * src/data/clocks.ts.
 */
import type { ClockOptions } from "../../lib/options";

type ClockComponent = (props: { opts: ClockOptions }) => unknown;

const modules = import.meta.glob<{ default: ClockComponent }>("./*.astro", { eager: true });

const registry = new Map<string, ClockComponent>();
for (const [file, mod] of Object.entries(modules)) {
  const name = file.replace(/^\.\//, "").replace(/\.astro$/, "");
  if (name === "ClockSwitch") continue;
  registry.set(name, mod.default);
}

function componentNameFor(slug: string): string {
  return slug
    .split("-")
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join("");
}

type Props = { slug: string; opts: ClockOptions };
const { slug, opts } = Astro.props;
const Clock = registry.get(componentNameFor(slug));
if (!Clock) {
  // Don't fail the whole build for one missing file; make it loud instead.
  console.warn(
    `[clocks] No component for slug "${slug}": expected src/components/clocks/${componentNameFor(slug)}.astro`,
  );
}
---

{Clock ? <Clock opts={opts} /> : <div data-clock-missing={slug}>missing: {slug}</div>}
