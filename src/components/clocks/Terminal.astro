---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
// strftime-style format shown in the prompt line; mirrors the current options.
const fmtText =
  (opts.format === "12" ? "%I:%M" : "%H:%M") + (opts.seconds ? ":%S" : "") + (opts.format === "12" ? " %p" : "");
---

<div
  class="tm"
  data-clock="terminal"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="window">
    <div class="bar" aria-hidden="true">
      <span class="dot dot-r"></span>
      <span class="dot dot-y"></span>
      <span class="dot dot-g"></span>
      <span class="title">~ / now</span>
    </div>
    <div class="body">
      <div class="line">
        <span class="prompt">$</span> <span class="cmd">date +"<span class="fmt">{fmtText}</span>"</span>
      </div>
      <div class="line out">
        <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>:--</span><span class="ampm"></span><span class="caret">▍</span>
      </div>
      <div class="line out date" hidden={!opts.date}>
        <span class="prompt">$</span> <span class="cmd">echo --/-- ---</span>
      </div>
      <div class="line live" hidden={!opts.live}>
        <span class="prompt">$</span> <span class="cmd">status: <span class="live-on">● ON_AIR</span></span>
      </div>
    </div>
  </div>
</div>

<style>
  .tm {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Share Tech Mono", "Menlo", monospace;
    color: var(--fg);
  }
  .window {
    background: var(--bg);
    border-radius: 8px;
    width: 320px;
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--fg) 25%, transparent),
      0 12px 30px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    background: color-mix(in srgb, var(--fg) 8%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--fg) 18%, transparent);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot-r {
    background: #ff5f56;
  }
  .dot-y {
    background: #ffbd2e;
  }
  .dot-g {
    background: #27c93f;
  }
  .title {
    margin-left: 8px;
    font-size: 11px;
    opacity: 0.75;
    letter-spacing: 1px;
  }
  .body {
    padding: 12px 14px 14px;
    font-size: 14px;
    line-height: 1.7;
  }
  .prompt {
    color: var(--accent);
    margin-right: 4px;
    font-weight: 700;
  }
  .cmd {
    opacity: 0.95;
  }
  .out {
    font-size: 26px;
    line-height: 1.15;
    margin-top: 2px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 1px;
  }
  .out.date {
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.85;
    margin-top: 4px;
  }
  .sec {
    opacity: 0.8;
  }
  .caret {
    display: inline-block;
    margin-left: 4px;
    animation: tm-caret 1s steps(2, end) infinite;
  }
  .live-on {
    color: #ff5f56;
    text-shadow: 0 0 8px color-mix(in srgb, #ff5f56 70%, transparent);
  }
  @keyframes tm-caret {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  import { mountDigital, formatDate, readFormat } from "../../lib/clock-runtime";

  for (const el of document.querySelectorAll<HTMLElement>(".tm")) {
    // Reflect the effective options (after URL overrides) in the prompt line.
    const fmtEl = el.querySelector<HTMLElement>(".fmt");
    if (fmtEl) {
      const h12 = readFormat(el) === "12";
      const sec = el.dataset.seconds === "1";
      fmtEl.textContent = (h12 ? "%I:%M" : "%H:%M") + (sec ? ":%S" : "") + (h12 ? " %p" : "");
    }
    mountDigital(el, {
      renderSeconds: (s) => ":" + s,
      dateSelector: ".date .cmd",
      renderDate: (p, lang) => "echo " + formatDate(p, lang),
    });
  }
</script>
