---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="mnl"
  data-clock="monoton-lines"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="box">
    <div class="row">
      <span class="hm">--:--</span>
      <span class="small">
        <span class="ampm"></span>
        <span class="sec" hidden={!opts.seconds}>--</span>
      </span>
    </div>
    <div class="floor" aria-hidden="true"><div class="grid"></div></div>
    <div class="meta">
      <span class="date" hidden={!opts.date}>--/-- ---</span>
      <span class="live" hidden={!opts.live}>ON AIR</span>
    </div>
  </div>
</div>

<style>
  .mnl {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Monoton", cursive;
    color: var(--fg);
  }
  .box {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 280px;
    padding: 4px 0;
    background: var(--bg);
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    line-height: 1;
  }
  .hm {
    font-size: 60px;
    background: linear-gradient(180deg, var(--accent), var(--fg));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--accent) 55%, transparent));
    font-variant-numeric: tabular-nums;
  }
  .small {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
    letter-spacing: 2px;
  }
  .ampm:empty {
    display: none;
  }
  /* nothing to show beside the digits (24h, seconds off) */
  .small:not(:has(.sec:not([hidden]))):has(.ampm:empty) {
    display: none;
  }
  .floor {
    width: 100%;
    height: 40px;
    margin-top: -2px;
    overflow: hidden;
    perspective: 160px;
    mask-image: linear-gradient(to bottom, transparent, #000 40%);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 40%);
  }
  .grid {
    height: 200%;
    transform-origin: 50% 0;
    transform: rotateX(60deg);
    background-image:
      repeating-linear-gradient(90deg, color-mix(in srgb, var(--accent) 40%, transparent) 0 1px, transparent 1px 28px),
      repeating-linear-gradient(180deg, color-mix(in srgb, var(--accent) 40%, transparent) 0 1px, transparent 1px 20px);
    animation: mnl-floor 2s linear infinite;
  }
  .meta {
    display: flex;
    gap: 14px;
    margin-top: 2px;
    font-family: system-ui, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    line-height: 1;
  }
  .live {
    color: var(--accent);
  }
  @keyframes mnl-floor {
    to {
      background-position: 0 0, 0 20px;
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".mnl")) mountDigital(el);
</script>
