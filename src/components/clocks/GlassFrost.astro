---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="gf"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="pane">
    <div class="live" hidden={!opts.live}>
      <span class="dot" aria-hidden="true"></span>LIVE
    </div>
    <div class="time">
      <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
    </div>
    <div class="date" hidden={!opts.date}>--/-- ---</div>
  </div>
</div>

<style>
  .gf {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    padding: 6px;
  }
  .pane {
    position: relative;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid color-mix(in srgb, var(--fg) 45%, transparent);
    border-radius: 18px;
    padding: 14px 22px 16px;
    text-align: center;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
    padding: 2px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
  }
  .live .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .time {
    font-size: 42px;
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: 0.5px;
    font-variant-numeric: tabular-nums;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .sec {
    font-size: 22px;
    font-weight: 600;
    opacity: 0.65;
  }
  .date {
    margin-top: 2px;
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 600;
    opacity: 0.7;
  }
</style>

<script>
  type Lang = "ja" | "en";
  function partsFor(tz: string) {
    const f = new Intl.DateTimeFormat("en-US", {
      timeZone: tz,
      hour12: false,
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      weekday: "short",
    });
    return Object.fromEntries(f.formatToParts(new Date()).map((p) => [p.type, p.value])) as Record<string, string>;
  }
  function wd(en: string | undefined, lang: Lang): string {
    if (!en) return "";
    if (lang === "en") return en.toUpperCase();
    return { Sun: "日", Mon: "月", Tue: "火", Wed: "水", Thu: "木", Fri: "金", Sat: "土" }[en] ?? "";
  }
  function init(el: HTMLElement) {
    const tz = el.dataset.tz || "Asia/Tokyo";
    const lang = (el.dataset.lang as Lang) || "ja";
    const format = el.dataset.format || "24";
    const hmEl = el.querySelector<HTMLElement>(".hm");
    const secEl = el.querySelector<HTMLElement>(".sec");
    const dateEl = el.querySelector<HTMLElement>(".date");
    if (!hmEl) return;
    function tick() {
      const p = partsFor(tz);
      let hour = p.hour;
      let suffix = "";
      if (format === "12") {
        const h = Number(hour);
        hour = String(((h + 11) % 12) + 1).padStart(2, "0");
        suffix = h >= 12 ? " PM" : " AM";
      }
      if (hmEl) hmEl.textContent = `${hour}:${p.minute}${suffix}`;
      if (secEl) secEl.textContent = p.second ?? "";
      if (dateEl) dateEl.textContent = `${p.month}/${p.day} ${wd(p.weekday, lang)}`;
    }
    tick();
    setInterval(tick, 1000);
  }
  for (const el of document.querySelectorAll<HTMLElement>(".gf")) init(el);
</script>
