---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="ft"
  data-clock="fight-timer"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="stage">
    <div class="side l">
      <div class="gauge" aria-hidden="true"><span class="fill"></span></div>
      <div class="strip date" hidden={!opts.date}>--/-- ---</div>
    </div>
    <div class="plate">
      <div class="inner">
        <span class="round">ROUND</span>
        <span class="hm">--:--</span><span class="ampm"></span>
        <span class="sec" hidden={!opts.seconds}>--</span>
      </div>
    </div>
    <div class="side r">
      <div class="gauge" aria-hidden="true"><span class="fill"></span></div>
      <div class="strip live" hidden={!opts.live}>● LIVE</div>
    </div>
  </div>
</div>

<style>
  .ft {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Bungee", "Impact", sans-serif;
    color: var(--fg);
  }
  .stage {
    display: flex;
    align-items: center;
    gap: 4px;
    width: 320px;
  }
  .side {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .gauge {
    position: relative;
    height: 14px;
    transform: skewX(-18deg);
    background: color-mix(in srgb, var(--accent) 80%, black);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.6), 0 0 0 2px color-mix(in srgb, var(--fg) 70%, transparent);
    overflow: hidden;
  }
  .fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--fg) 55%, #ffd23f), color-mix(in srgb, var(--fg) 15%, #e2a400));
    animation: ft-drain 12s ease-in-out infinite;
  }
  /* gauges drain from the outer edge inward, i.e. transform-origin on the centre side */
  .l .fill {
    transform-origin: right;
  }
  .r .fill {
    transform-origin: left;
  }
  @keyframes ft-drain {
    0%,
    100% {
      transform: scaleX(1);
    }
    45%,
    55% {
      transform: scaleX(0.28);
    }
  }
  .strip {
    font-size: 9px;
    letter-spacing: 1px;
    padding: 2px 8px;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    text-align: center;
    white-space: nowrap;
  }
  .l .strip {
    text-align: left;
  }
  .r .strip {
    text-align: right;
    color: var(--accent);
  }
  .plate {
    flex: 0 0 130px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 60%, white), var(--accent) 45%, color-mix(in srgb, var(--accent) 60%, black));
    clip-path: polygon(14% 0, 86% 0, 100% 50%, 86% 100%, 14% 100%, 0 50%);
    padding: 3px;
    box-sizing: border-box;
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--bg);
    clip-path: polygon(14% 0, 86% 0, 100% 50%, 86% 100%, 14% 100%, 0 50%);
    padding: 6px 0 7px;
    line-height: 1;
  }
  .round {
    font-size: 8px;
    letter-spacing: 2px;
    color: var(--accent);
    margin-bottom: 3px;
  }
  .hm {
    font-size: 26px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-shadow:
      -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 2px 2px 0 #000,
      0 3px 0 #000;
  }
  .ampm {
    font-size: 9px;
    letter-spacing: 1px;
    opacity: 0.85;
  }
  .ampm:empty {
    display: none;
  }
  .sec {
    font-size: 11px;
    margin-top: 2px;
    color: var(--accent);
    text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".ft")) mountDigital(el);
</script>
