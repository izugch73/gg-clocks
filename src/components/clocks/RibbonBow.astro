---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="rb"
  data-clock="ribbon-bow"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="lace">
    <div class="card">
      <span class="live" hidden={!opts.live}>LIVE</span>
      <div class="time">
        <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
      </div>
      <div class="drow" data-with="date" hidden={!opts.date}>
        <span class="heart" aria-hidden="true">♥</span>
        <span class="date">--/-- ---</span>
        <span class="heart" aria-hidden="true">♥</span>
      </div>
    </div>
    <svg class="bow" viewBox="0 0 130 80" width="130" height="80" aria-hidden="true">
      <!-- tails -->
      <path d="M58 32 L34 78 L50 70 L58 40 Z" class="tail" />
      <path d="M72 32 L96 78 L80 70 L72 40 Z" class="tail" />
      <path d="M58 34 L46 60" class="tail-shade" />
      <path d="M72 34 L84 60" class="tail-shade" />
      <!-- loops -->
      <path d="M65 28 C46 4, 6 8, 12 30 C16 46, 48 42, 65 28 Z" class="loop" />
      <path d="M65 28 C84 4, 124 8, 118 30 C114 46, 82 42, 65 28 Z" class="loop" />
      <path d="M60 28 C44 18, 24 20, 24 30 C24 38, 46 36, 60 28 Z" class="loop-inner" />
      <path d="M70 28 C86 18, 106 20, 106 30 C106 38, 84 36, 70 28 Z" class="loop-inner" />
      <path d="M22 22 C32 12, 44 12, 54 18" class="shine" />
      <path d="M108 22 C98 12, 86 12, 76 18" class="shine" />
      <!-- knot -->
      <ellipse cx="65" cy="29" rx="10" ry="9" class="knot" />
      <path d="M60 24 C64 22, 68 22, 70 24" class="shine" />
    </svg>
  </div>
</div>

<style>
  .rb {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Hachi Maru Pop", "Kosugi Maru", sans-serif;
    padding-top: 22px; /* room for the bow overhang */
  }
  .lace {
    position: relative;
    padding: 7px;
    width: 240px;
    /* scalloped lace: white dots whose outer halves peek past the card */
    background: radial-gradient(circle, color-mix(in srgb, #fff 88%, var(--accent)) 0 4.6px, transparent 5.2px) 0 0 / 14px 14px;
    border-radius: 18px;
  }
  .card {
    position: relative;
    background: var(--bg);
    color: var(--fg);
    border-radius: 14px;
    padding: 30px 16px 14px;
    text-align: center;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14);
  }
  .live {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 10px;
    letter-spacing: 1px;
    transform: rotate(-8deg);
  }
  .time {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
    line-height: 1.1;
  }
  .hm {
    font-size: 36px;
    font-variant-numeric: tabular-nums;
  }
  .sec {
    font-size: 18px;
    color: var(--accent);
  }
  .drow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 6px;
    font-size: 14px;
    color: color-mix(in srgb, var(--fg) 80%, transparent);
  }
  .heart {
    color: var(--accent);
    font-size: 10px;
  }
  .bow {
    position: absolute;
    top: -22px;
    left: 50%;
    margin-left: -65px;
    animation: rb-bob 2.5s ease-in-out infinite;
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.18));
  }
  .loop,
  .tail,
  .knot {
    fill: var(--accent);
  }
  .loop-inner,
  .tail-shade {
    fill: color-mix(in srgb, var(--accent) 70%, #000);
  }
  .tail-shade {
    fill: none;
    stroke: color-mix(in srgb, var(--accent) 70%, #000);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .knot {
    fill: color-mix(in srgb, var(--accent) 85%, #000);
  }
  .shine {
    fill: none;
    stroke: rgba(255, 255, 255, 0.7);
    stroke-width: 2;
    stroke-linecap: round;
  }
  @keyframes rb-bob {
    50% {
      transform: translateY(2px);
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".rb")) mountDigital(el);
</script>
