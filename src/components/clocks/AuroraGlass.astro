---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="ag"
  data-clock="aurora-glass"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="panel">
    <div class="blob a" aria-hidden="true"></div>
    <div class="blob b" aria-hidden="true"></div>
    <div class="content">
      <div class="live" hidden={!opts.live}><span class="dot" aria-hidden="true"></span>LIVE</div>
      <div class="time"><span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span></div>
      <div class="date" hidden={!opts.date}>--/-- ---</div>
    </div>
  </div>
</div>

<style>
  .ag {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Comfortaa", system-ui, sans-serif;
  }
  .panel {
    position: relative;
    width: 240px;
    box-sizing: border-box;
    padding: 14px 18px 14px;
    border-radius: 18px;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 10px 30px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    isolation: isolate;
    text-align: center;
    color: var(--fg);
  }
  /* aurora: two blurred radial blobs drifting across the glass */
  .blob {
    position: absolute;
    width: 180px;
    height: 120px;
    border-radius: 50%;
    filter: blur(22px);
    opacity: 0.75;
    pointer-events: none;
    z-index: 0;
  }
  .blob.a {
    left: -40px;
    top: -30px;
    background: radial-gradient(closest-side, var(--accent), transparent);
    animation: ag-drift-a 14s ease-in-out infinite alternate;
  }
  .blob.b {
    right: -50px;
    bottom: -40px;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--fg) 45%, #16c7a8), transparent);
    animation: ag-drift-b 14s ease-in-out infinite alternate;
  }
  .content {
    position: relative;
    z-index: 1;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 4px;
    padding: 2px 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
  }
  .live .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
  }
  .time {
    font-size: 44px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
    text-shadow:
      0 0 10px color-mix(in srgb, var(--fg) 55%, transparent),
      0 0 24px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .sec {
    font-size: 20px;
    margin-left: 6px;
    opacity: 0.8;
  }
  .date {
    margin-top: 6px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    opacity: 0.6;
  }
  @keyframes ag-drift-a {
    to {
      transform: translate(120px, 30px);
    }
  }
  @keyframes ag-drift-b {
    to {
      transform: translate(-130px, -20px);
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".ag")) mountDigital(el);
</script>
