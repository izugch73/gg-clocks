---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="ad"
  data-clock="analog-dot"
  data-seconds={opts.seconds ? "1" : "0"}
  data-tz={opts.tz}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <svg viewBox="0 0 200 200" width="200" height="200" aria-hidden="true">
    <circle cx="100" cy="100" r="98" class="face" />
    {Array.from({ length: 12 }).map((_, i) => {
      const angle = (i / 12) * Math.PI * 2 - Math.PI / 2;
      const r = 84;
      const x = 100 + Math.cos(angle) * r;
      const y = 100 + Math.sin(angle) * r;
      return <circle cx={x} cy={y} r={i % 3 === 0 ? 3.5 : 2} class={i % 3 === 0 ? "tick tick-major" : "tick"} />;
    })}

    <g class="hand-h">
      <line x1="100" y1="108" x2="100" y2="55" class="hand hand-hour" />
    </g>
    <g class="hand-m">
      <line x1="100" y1="112" x2="100" y2="32" class="hand hand-min" />
    </g>
    <g class="hand-s sec" {...(opts.seconds ? {} : { hidden: true })}>
      <line x1="100" y1="118" x2="100" y2="24" class="hand hand-sec" />
    </g>
    <circle cx="100" cy="100" r="3.5" class="pin" />
    <circle cx="100" cy="100" r="1.5" class="pin-center" />
  </svg>
</div>

<style>
  .ad {
    transform: scale(var(--scale, 1));
    transform-origin: center;
  }
  .ad svg {
    display: block;
  }
  .face {
    fill: var(--bg);
  }
  .tick {
    fill: var(--fg);
    opacity: 0.45;
  }
  .tick-major {
    opacity: 0.95;
  }
  .hand {
    stroke: var(--fg);
    stroke-linecap: round;
  }
  .hand-hour {
    stroke-width: 4;
  }
  .hand-min {
    stroke-width: 2.5;
  }
  .hand-sec {
    stroke: var(--accent);
    stroke-width: 1.2;
  }
  .pin {
    fill: var(--fg);
  }
  .pin-center {
    fill: var(--accent);
  }
  .hand-h,
  .hand-m,
  .hand-s {
    transform-origin: 100px 100px;
    transition: transform 0.2s cubic-bezier(0.4, 2.2, 0.6, 1);
  }
  .hand-s {
    transition: transform 0.15s cubic-bezier(0.4, 2.2, 0.6, 1);
  }
</style>

<script>
  import { mountAnalog } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".ad")) mountAnalog(el);
</script>
