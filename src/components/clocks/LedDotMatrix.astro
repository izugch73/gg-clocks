---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="dm"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="panel">
    <div class="grid" aria-hidden="true"></div>
    <div class="content">
      <div class="live" hidden={!opts.live}>● LIVE</div>
      <div class="time"><span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span></div>
      <div class="date" hidden={!opts.date}>--/-- ---</div>
    </div>
  </div>
</div>

<style>
  .dm {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    padding: 8px;
    font-family: "Share Tech Mono", "Courier New", monospace;
  }
  .panel {
    position: relative;
    background: var(--bg);
    color: var(--fg);
    padding: 18px 24px;
    border-radius: 6px;
    overflow: hidden;
    box-shadow:
      inset 0 0 0 2px color-mix(in srgb, var(--fg) 15%, transparent),
      inset 0 0 24px rgba(0, 0, 0, 0.6);
  }
  /* dot grid as background — radial gradients tiled */
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at center, color-mix(in srgb, var(--fg) 18%, transparent) 1.4px, transparent 2px);
    background-size: 7px 7px;
    pointer-events: none;
    opacity: 0.85;
  }
  .content {
    position: relative;
    text-align: center;
  }
  .live {
    display: inline-block;
    margin-bottom: 4px;
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--accent);
    text-shadow:
      0 0 6px var(--accent),
      0 0 14px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .time {
    font-size: 48px;
    line-height: 1;
    letter-spacing: 4px;
    font-weight: 700;
    text-shadow:
      0 0 4px var(--fg),
      0 0 14px color-mix(in srgb, var(--fg) 75%, transparent),
      0 0 30px color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .sec {
    font-size: 26px;
    margin-left: 6px;
    opacity: 0.85;
  }
  .date {
    margin-top: 6px;
    font-size: 13px;
    letter-spacing: 6px;
    opacity: 0.85;
    text-shadow:
      0 0 6px color-mix(in srgb, var(--fg) 75%, transparent);
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".dm")) mountDigital(el);
</script>
