---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="st"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="card">
    <div class="live" hidden={!opts.live}>LIVE</div>
    <div class="time">
      <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
    </div>
    <div class="date" hidden={!opts.date}>--/-- ---</div>
  </div>
</div>

<style>
  .st {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    padding: 6px;
  }
  .card {
    position: relative;
    background: var(--accent);
    border: 3px solid var(--fg);
    border-radius: 22px;
    padding: 14px 22px 16px;
    color: var(--fg);
    text-align: center;
    box-shadow: 4px 5px 0 var(--fg);
  }
  .card::before {
    content: "";
    position: absolute;
    inset: 4px;
    border: 1.5px dashed color-mix(in srgb, var(--fg) 35%, transparent);
    border-radius: 18px;
    pointer-events: none;
  }
  .live {
    display: inline-block;
    margin: 0 0 4px;
    padding: 2px 10px;
    background: var(--fg);
    color: var(--accent);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
  }
  .time {
    font-size: 36px;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: 1.5px;
    font-variant-numeric: tabular-nums;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .sec {
    font-size: 20px;
    font-weight: 700;
    opacity: 0.75;
  }
  .date {
    margin-top: 2px;
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0.75;
    font-weight: 700;
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".st")) mountDigital(el);
</script>
