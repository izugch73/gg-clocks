---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="cbs"
  data-clock="comic-burst"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <svg class="burst" viewBox="0 0 250 150" width="250" height="150" aria-hidden="true">
    <polygon
      points="125.0,4.0 146.5,19.6 177.5,11.0 185.4,30.6 219.6,30.7 212.2,50.4 243.0,59.2 221.8,75.0 243.0,90.8 212.2,99.6 219.6,119.3 185.4,119.4 177.5,139.0 146.5,130.4 125.0,146.0 103.5,130.4 72.5,139.0 64.6,119.4 30.4,119.3 37.8,99.6 7.0,90.8 28.2,75.0 7.0,59.2 37.8,50.4 30.4,30.7 64.6,30.6 72.5,11.0 103.5,19.6"
    />
  </svg>
  <div class="panel">
    <span class="live" hidden={!opts.live}>LIVE!</span>
    <div class="time">
      <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span>
    </div>
  </div>
  <span class="date" hidden={!opts.date}>--/-- ---</span>
</div>

<style>
  /* Comic ink is intentionally a fixed near-black: the concept is a black-outlined burst. */
  .cbs {
    --ink: #111;
    position: relative;
    width: 250px;
    height: 150px;
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Bungee", "Impact", sans-serif;
    color: var(--fg);
  }
  .burst {
    position: absolute;
    inset: 0;
    fill: var(--accent);
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linejoin: round;
    animation: cbs-pulse 2s ease-in-out infinite alternate;
    transform-origin: center;
  }
  @keyframes cbs-pulse {
    to {
      transform: scale(1.04);
    }
  }
  .panel {
    position: absolute;
    left: 28px;
    top: 36px;
    width: 194px;
    height: 76px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform: rotate(-4deg);
    border: 3px solid var(--ink);
    border-radius: 10px;
    background-color: var(--bg);
    /* Ben-Day halftone dots */
    background-image: radial-gradient(circle, color-mix(in srgb, var(--fg) 12%, transparent) 1.4px, transparent 1.6px);
    background-size: 8px 8px;
  }
  .live {
    position: absolute;
    top: -12px;
    left: 10px;
    padding: 2px 7px;
    background: var(--ink);
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 1px;
    border-radius: 4px;
    transform: rotate(-6deg);
  }
  .time {
    display: flex;
    align-items: baseline;
    gap: 6px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .hm {
    font-size: 48px;
    -webkit-text-stroke: 3px var(--ink);
    paint-order: stroke fill;
    text-shadow: 4px 4px 0 var(--ink);
  }
  .sec {
    font-size: 20px;
    -webkit-text-stroke: 2px var(--ink);
    paint-order: stroke fill;
    text-shadow: 2px 2px 0 var(--ink);
  }
  .date {
    position: absolute;
    right: 18px;
    bottom: 10px;
    padding: 3px 9px;
    background: var(--ink);
    color: var(--bg);
    font-size: 12px;
    letter-spacing: 1px;
    border-radius: 4px;
    transform: rotate(3deg);
    box-shadow: 2px 2px 0 color-mix(in srgb, var(--ink) 40%, transparent);
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".cbs")) mountDigital(el);
</script>
