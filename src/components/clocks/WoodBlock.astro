---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="wb"
  data-clock="wood-block"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="block">
    <div class="grain" aria-hidden="true"></div>
    <svg class="leaf" viewBox="0 0 28 28" width="28" height="28" aria-hidden="true">
      <path class="stem" d="M14 26 C 14 18, 15 12, 20 6" fill="none" stroke-width="1.6" stroke-linecap="round" />
      <path class="blade" d="M20 6 C 10 4, 4 10, 5 19 C 13 20, 20 15, 20 6 Z" />
      <path d="M7 17 C 11 13, 15 10, 19 7" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1" stroke-linecap="round" />
    </svg>
    <div class="live" hidden={!opts.live}>● LIVE</div>
    <div class="time"><span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>--</span></div>
    <div class="date" hidden={!opts.date}>--/-- ---</div>
  </div>
</div>

<style>
  .wb {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    padding: 4px 4px 10px;
    font-family: "Comfortaa", system-ui, sans-serif;
  }
  .block {
    position: relative;
    width: 230px;
    box-sizing: border-box;
    padding: 12px 18px 12px;
    border-radius: 14px;
    background: var(--bg);
    color: var(--fg);
    text-align: center;
    overflow: hidden;
    /* 3D bottom edge + soft contact shadow */
    box-shadow:
      0 6px 0 color-mix(in srgb, var(--bg) 65%, black),
      0 10px 16px rgba(0, 0, 0, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }
  /* wood grain: a few slightly-angled line sets */
  .grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      repeating-linear-gradient(1deg, color-mix(in srgb, var(--fg) 6%, transparent) 0 1px, transparent 1px 9px),
      repeating-linear-gradient(-2deg, color-mix(in srgb, var(--fg) 5%, transparent) 0 1px, transparent 1px 14px),
      repeating-linear-gradient(3deg, color-mix(in srgb, var(--fg) 4%, transparent) 0 2px, transparent 2px 23px),
      radial-gradient(ellipse 60px 18px at 22% 70%, color-mix(in srgb, var(--fg) 9%, transparent), transparent 70%);
  }
  .leaf {
    position: absolute;
    top: 4px;
    right: 8px;
    transform: rotate(12deg);
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.2));
  }
  .stem {
    stroke: var(--accent);
  }
  .blade {
    fill: var(--accent);
  }
  .live {
    position: relative;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 2px;
    color: var(--accent);
  }
  /* engraved look: light edge below, dark edge above */
  .time {
    position: relative;
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
    text-shadow:
      0 1px 0 rgba(255, 255, 255, 0.4),
      0 -1px 0 rgba(0, 0, 0, 0.3);
  }
  .sec {
    font-size: 18px;
    margin-left: 5px;
    opacity: 0.8;
  }
  .date {
    position: relative;
    margin-top: 6px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    opacity: 0.85;
    text-shadow:
      0 1px 0 rgba(255, 255, 255, 0.35),
      0 -1px 0 rgba(0, 0, 0, 0.25);
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".wb")) mountDigital(el);
</script>
