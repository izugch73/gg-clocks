---
import type { ClockOptions } from "../../lib/options";
type Props = { opts: ClockOptions };
const { opts } = Astro.props;
---

<div
  class="rs"
  data-clock="roll-sign"
  data-format={opts.format}
  data-seconds={opts.seconds ? "1" : "0"}
  data-date={opts.date ? "1" : "0"}
  data-live={opts.live ? "1" : "0"}
  data-tz={opts.tz}
  data-lang={opts.lang}
  style={`--fg:${opts.fg};--bg:${opts.bg};--accent:${opts.accent};--scale:${opts.scale};`}
>
  <div class="frame">
    <i class="rivet tl" aria-hidden="true"></i>
    <i class="rivet tr" aria-hidden="true"></i>
    <i class="rivet bl" aria-hidden="true"></i>
    <i class="rivet br" aria-hidden="true"></i>
    <span class="live" hidden={!opts.live}>● LIVE</span>
    <div class="window">
      <div class="route date" hidden={!opts.date}>--/-- ---</div>
      <div class="main">
        <span class="badge" aria-hidden="true">各停</span>
        <span class="hm">--:--</span><span class="sec" hidden={!opts.seconds}>:--</span>
      </div>
      <!-- other destinations rolling past every 30s -->
      <div class="strip" aria-hidden="true">
        <span>回送</span><span>急行</span><span>快速</span><span>試運転</span>
      </div>
    </div>
  </div>
</div>

<style>
  .rs {
    transform: scale(var(--scale, 1));
    transform-origin: center;
    font-family: "Zen Kaku Gothic New", sans-serif;
    color: var(--fg);
  }
  /* cream metal frame, tinted from fg */
  .frame {
    position: relative;
    width: 280px;
    padding: 10px 12px;
    border-radius: 6px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--fg) 82%, #6b5e3c),
      color-mix(in srgb, var(--fg) 62%, #3a3324)
    );
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--fg) 95%, transparent),
      0 6px 14px rgba(0, 0, 0, 0.35);
  }
  .rivet {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, color-mix(in srgb, var(--fg) 95%, #fff), color-mix(in srgb, var(--fg) 40%, #000));
  }
  .tl { top: 3px; left: 4px; }
  .tr { top: 3px; right: 4px; }
  .bl { bottom: 3px; left: 4px; }
  .br { bottom: 3px; right: 4px; }
  .live {
    position: absolute;
    top: 0;
    right: 16px;
    font-size: 8px;
    line-height: 10px;
    letter-spacing: 1.5px;
    font-weight: 700;
    color: var(--accent);
  }
  .window {
    position: relative;
    height: 70px;
    padding: 4px 10px;
    border-radius: 3px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 25%, transparent), inset 0 4px 10px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  /* thin roll edges at top and bottom of the film */
  .window::before,
  .window::after {
    content: "";
    position: absolute;
    left: 6px;
    right: 6px;
    height: 1px;
    background: color-mix(in srgb, var(--fg) 30%, transparent);
    z-index: 2;
  }
  .window::before { top: 3px; }
  .window::after { bottom: 3px; }
  .route {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    opacity: 0.8;
    margin-bottom: 2px;
  }
  .main {
    display: flex;
    align-items: center;
    gap: 10px;
    line-height: 1;
  }
  .badge {
    font-size: 13px;
    font-weight: 700;
    padding: 3px 6px;
    border-radius: 2px;
    background: var(--accent);
    color: var(--fg);
  }
  .hm {
    font-size: 34px;
    font-weight: 900;
    letter-spacing: 2px;
    font-variant-numeric: tabular-nums;
  }
  .sec {
    font-size: 18px;
    font-weight: 700;
    opacity: 0.85;
  }
  .strip {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    background: var(--bg);
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 4px;
    filter: blur(1.2px);
    transform: translateY(100%);
    animation: rs-roll 30s steps(16, end) infinite;
  }
  @keyframes rs-roll {
    0%,
    91% {
      transform: translateY(100%);
    }
    100% {
      transform: translateY(-100%);
    }
  }
</style>

<script>
  import { mountDigital } from "../../lib/clock-runtime";
  for (const el of document.querySelectorAll<HTMLElement>(".rs")) mountDigital(el, { renderSeconds: (s) => ":" + s });
</script>
